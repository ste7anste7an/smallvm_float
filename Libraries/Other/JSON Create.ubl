module 'JSON Create' Data
author 'Bjarke Gotfredsen, Peter Mathijssen'
version 1 1 
description 'This library assist in creating JSON structures:
Use "json" to create key/value pairs
Add a list with json pairs as input to "json structure"
You can nest jsons. Prettify json Structures with "pretty"
See example https://apps.springbot.co.za/examples.html#JSON
'

  spec 'r' 'jsncr_json' 'json _ _' 'auto auto' 'key' 'value or json structure'
  spec 'r' 'jsncr_json structure' 'json structure _' 'auto' 'list of jsons'
  space
  spec 'r' 'jsncr_pretty' 'pretty _' 'auto' 'json structure'
  advanced
  spec 'r' 'jsncr_str' 'str _' 'auto' 'string'

to jsncr_json key value {
  return (ifExpression (and (isType key 'string') (not (isType value 'list'))) ('[data:join]' (jsncr_str key) ':' (jsncr_str value)) '')
}

to 'jsncr_json structure' s {
  return (ifExpression (isType s 'list') ('[data:join]' '{' ('[data:joinStrings]' s ',') '}') ('[data:join]' '{' s '}'))
}

to jsncr_pretty json {
  local 'crlf' ('[data:unicodeString]' 10)
  local 'indent' ('[data:makeList]')
  local 'o' ('[data:toString]' '')
  for i (size json) {
    local 'c' (at i json)
    if (c == '{') {
      '[data:addLast]' '  ' indent
      o = ('[data:join]' o c crlf ('[data:joinStrings]' indent))
    } (c == '}') {
      '[data:delete]' 1 indent
      o = ('[data:join]' o crlf ('[data:joinStrings]' indent) c)
    } (c == ',') {
      o = ('[data:join]' o c crlf ('[data:joinStrings]' indent))
    } (c == ':') {
      o = ('[data:join]' o c ' ')
    } else {
      o = ('[data:join]' o c)
    }
  }
  return o
}

to jsncr_str s {
  return (ifExpression (and (isType s 'string') ((at 1 s) != '{')) ('[data:join]' '"' s '"') s)
}

