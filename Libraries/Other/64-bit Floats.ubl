module '64-bit Floats' Operators
author MicroBlocks
version 2 2
description 'Requires firmware built with -DUSE_64BIT_FLOAT. Adds IEEE-754 64-bit floating-point values while preserving the original MicroBlocks integer range and operations. Trigonometric inputs and results use radians. Formatting width is a minimum; use a negative width to left-align. Decimal digits and exponent digits are clamped to 0-30.'
tags math number float '64-bit'
choices float64PrintfFormat f e

	spec 'r' '[misc:float64FromString]' '64-bit float from text _' 'str' '3.141592653589793'
	spec 'r' '[misc:isFloat64]' '_ is a 64-bit float?' 'auto' 0
	-
	spec 'r' '[misc:float64Sqrt]' '64-bit sqrt _' 'num' 2
	spec 'r' '[misc:float64Power]' '64-bit _ to power _' 'num num' 2 8
	spec 'r' '[misc:float64Sin]' '64-bit sin radians _' 'num' 0
	spec 'r' '[misc:float64Cos]' '64-bit cos radians _' 'num' 0
	spec 'r' '[misc:float64Tan]' '64-bit tan radians _' 'num' 0
	spec 'r' '[misc:float64Atan]' '64-bit arctan _ (radians)' 'num' 1
	spec 'r' '[misc:float64Atan2]' '64-bit arctan x _ y _ (radians)' 'num num' 1 1
	-
	spec 'r' '[misc:roundFloat64ToInt]' 'round 64-bit float _ to integer' 'num' 1
	spec 'r' '[misc:truncateFloat64ToInt]' 'truncate 64-bit float _ to integer' 'num' 1
	spec 'r' '[misc:float64Rescale]' '64-bit rescale _ from ( _ , _ ) to ( _ , _ )' 'num num num num num' 3 0 10 0 100
	-
	spec 'r' '[data:float64ToString]' '64-bit float _ as text' 'auto' 0
	spec 'r' '[data:float64Printf]' '64-bit printf _ as % _ width _ digits _ : exponent digits _' 'num menu.float64PrintfFormat num num num' 3 'f' 0 6 2

