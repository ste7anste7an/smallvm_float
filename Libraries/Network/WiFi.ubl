module WiFi Comm
author MicroBlocks
version 1 13
tags communication network
description 'Connect to a WiFi network. Used in conjunction with other network libraries, such as HTTP client, HTTP server or Web Thing.

Leave the IP, gateway and subnet inputs of the connect block empty to get an address from the network. To use a fixed address fill in all three, for example 192.168.1.42, 192.168.1.1 and 255.255.255.0. A hotspot with an empty password is open; otherwise the password needs at least 8 characters. A hotspot uses channel 1 and the address 192.168.4.1 unless you fill in the channel (1 to 13) or IP inputs, for example 6 and 10.0.0.1. Some devices, for example ones sold in the US or Canada, do not show channels 12 and 13.
'

  spec ' ' 'wifiConnect' 'wifi connect to _ password _ : IP _ gateway _ subnet _' 'str str auto auto auto' 'Network_Name' '' '' '' ''
  spec ' ' 'wifiCreateHotspot' 'wifi create hotspot _ password _ : channel _ : IP _' 'str str num auto' 'Network_Name' 'Network_Password' 1 ''
  spec ' ' '[net:stopWiFi]' 'stop wifi'
  space
  spec ' ' '[net:setDomainName]' 'wifi set local domain name _ .local' 'str' 'microblocks'
  space
  spec 'r' 'getIPAddress' 'IP address'
  spec 'r' '[net:myMAC]' 'MAC address'
  space
  spec ' ' '[net:allowWiFiAndBLE]' 'allow WiFi while using BLE _' 'bool' true

to getIPAddress {
  return ('[net:myIPAddress]')
}

to wifiConnect ssid password fixedIP gatewayIP subnetIP {
  if (not ('[net:hasWiFi]')) {return}
  '[net:stopWiFi]'
  if ((pushArgCount) < 5) {
    '[net:startWiFi]' ssid password
  } else {
    '[net:startWiFi]' ssid password false fixedIP gatewayIP subnetIP
  }
  local 'startMSecs' (millisOp)
  repeatUntil (('[net:myIPAddress]') != '0.0.0.0') {
    comment 'Timeout after N seconds'
    if (((millisOp) - startMSecs) > 30000) {
      sayIt 'Could not connect'
      return 0
    }
    comment 'Slow blink while trying to connect'
    setUserLED true
    waitMillis 300
    setUserLED false
    waitMillis 300
  }
  repeat 6 {
    comment 'Quick blinks when connected'
    setUserLED true
    waitMillis 50
    setUserLED false
    waitMillis 50
  }
  '[net:setDomainName]' 'microblocks'
  sayIt 'My IP address is:' ('[net:myIPAddress]')
}

to wifiCreateHotspot ssid password channel ip {
  local 'channel' (argOrDefault 3 1)
  local 'ip' (argOrDefault 4 '')
  if (not ('[net:hasWiFi]')) {return}
  comment 'An empty password makes an open hotspot; WPA2 needs at least 8 characters.'
  if (and ((size password) > 0) ((size password) < 8)) {
    sayIt 'Password must be empty or at least 8 characters'
    return 0
  }
  if (not (and (channel >= 1) (channel <= 13))) {
    sayIt 'Channel must be 1 to 13'
    return 0
  }
  comment 'The hotspot is the gateway of its own network.'
  ip = ('[data:join]' '' ip)
  '[net:startWiFi]' ssid password true ip ip '255.255.255.0' channel
  if ('Connected' != ('[net:wifiStatus]')) {
    sayIt 'Could not create hotspot'
    return 0
  }
  repeat 6 {
    comment 'Quick blinks when connected'
    setUserLED true
    waitMillis 50
    setUserLED false
    waitMillis 50
  }
  '[net:setDomainName]' 'microblocks'
  sayIt 'My IP address is:' ('[net:myIPAddress]')
}

