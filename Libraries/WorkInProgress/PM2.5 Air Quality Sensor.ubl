module 'PM2.5 Air Quality Sensor' Input
author 'per MicroBlocks'
version 1 0
choices pmReading 'PM1.0 µg/m³ (CF=1, standard)' 'PM2.5 µg/m³ (CF=1, standard)' 'PM10 µg/m³ (CF=1, standard)' 'PM1.0 µg/m³ (atmospheric environment)' 'PM2.5 µg/m³ (atmospheric environment)' 'PM10 µg/m³ (atmospheric environment)' 'Number of particles >= 0.3µm / 0.1l air' 'Number of particles >= 0.5µm / 0.1l air' 'Number of particles >= 1.0µm / 0.1l air' 'Number of particles >= 2.5µm / 0.1l air' 'Number of particles >= 5µm / 0.1l air' 'Number of particles < 10µm / 0.1l air' 'Formaldehyde mg/m³' 
description 'PM2.5 Air Quality Sensor (I2C). Based on Plantower PMS5003:
https://www.aqmd.gov/docs/default-source/aq-spec/resources-page/plantower-pms5003-manual_v2-3.pdf

It is programmatically limited to obtaining PM readings every two seconds.
This sensor is part of the Educacont 5.0 project for measuring air quality parameters.
https://sites.google.com/view/educacont-5-0
'
variables _pmData _pmLast _pmValid 

  spec 'r' 'pm_particleSensorRead' 'pm get _' 'menu.pmReading' 'PM1.0 µg/m³ (atmospheric environment)'
  space
  spec 'r' '_pmIndex' '_pm get index _' 'str'
  spec ' ' '_pmRefresh' '_pm refresh'

to '_pmIndex' option {
  local 'options' ('[data:makeList]' 'PM1.0 µg/m³ (CF=1, standard)' 'PM2.5 µg/m³ (CF=1, standard)' 'PM10 µg/m³ (CF=1, standard)' 'PM1.0 µg/m³ (atmospheric environment)' 'PM2.5 µg/m³ (atmospheric environment)' 'PM10 µg/m³ (atmospheric environment)' 'Number of particles >= 0.3µm / 0.1l air' 'Number of particles >= 0.5µm / 0.1l air' 'Number of particles >= 1.0µm / 0.1l air' 'Number of particles >= 2.5µm / 0.1l air' 'Number of particles >= 5µm / 0.1l air' 'Number of particles < 10µm / 0.1l air' 'Formaldehyde mg/m³')
  return ('[data:find]' option options)
}

to '_pmRefresh' {
  local 'sensor' ('[data:newByteArray]' 32)
  local 'checkSum' 0
  '[sensors:i2cSetClockSpeed]' 100000
  '[sensors:i2cRead]' (hexToInt '2A') sensor
  '[sensors:i2cSetClockSpeed]' 400000
  for i 30 {
    checkSum = (checkSum + (at i sensor))
  }
  if ((((at 31 sensor) << 8) | (at 32 sensor)) != checkSum) {
    _pmValid = (booleanConstant false)
    return 0
  }
  _pmData = sensor
  _pmLast = (millisOp)
  _pmValid = (booleanConstant true)
}

to pm_particleSensorRead option {
  local 'idx' ('_pmIndex' option)
  if (idx < 1) {
    return 0
  }
  if (or (_pmLast == 0) ((millisSince _pmLast) >= 2000)) {
    '_pmRefresh'
  }
  if (not _pmValid) {
    return 'Invalid measurement'
  }
  local 'pos' ((2 * idx) + 3)
  local 'value' (((at pos _pmData) << 8) | (at (pos + 1) _pmData))
  if (idx == 13) {
    return ((value + 500) / 1000)
  }
  return value
}

