to readColor {
  if (not ('_planetX_colorEnsure')) {
    return 0
  }
  local 'r' 0
  local 'g' 0
  local 'b' 0
  local 'temp_c' 0
  local 'temp_r' 0
  local 'temp_g' 0
  local 'temp_b' 0
  if _planetX_colorNewMode {
    waitMillis 100
    _planetX_colorClear = ('_planetX_colorReadUInt16LE' 166)
    r = ('_planetX_colorReadUInt16LE' 160)
    g = ('_planetX_colorReadUInt16LE' 162)
    b = ('_planetX_colorReadUInt16LE' 164)
    r = ((r * 507) / 1000)
    g = ((g * 321) / 1000)
    b = ((b * 276) / 1000)
    _planetX_colorClear = ((_planetX_colorClear * 3) / 10)
    if (and (r > b) (r > g)) {
      b = ((b * 118) / 100)
      g = ((g * 95) / 100)
    }
    temp_c = _planetX_colorClear
    temp_r = r
    temp_g = g
    temp_b = b
    r = (minimum r 4095)
    g = (minimum g 4095)
    b = (minimum b 4095)
    _planetX_colorClear = (minimum _planetX_colorClear 4095)
    if (temp_b < temp_g) {
      local 'temp' temp_b
      temp_b = temp_g
      temp_g = temp
    }
  } else {
    local 'tries' 0
    repeatUntil (or ((('_planetX_colorReadReg' 147) & 1) == 1) (tries >= 40)) {
      tries += 1
      waitMillis 5
    }
    _planetX_colorClear = ('_planetX_colorReadUInt16LE' 148)
    r = ('_planetX_colorReadUInt16LE' 150)
    g = ('_planetX_colorReadUInt16LE' 152)
    b = ('_planetX_colorReadUInt16LE' 154)
    temp_c = _planetX_colorClear
    temp_r = r
    temp_g = g
    temp_b = b
  }
  local 'avg' (maximum 1 (_planetX_colorClear / 3))
  _planetX_colorR = (maximum 0 (minimum ((r * 255) / avg) 255))
  _planetX_colorG = (maximum 0 (minimum ((g * 255) / avg) 255))
  _planetX_colorB = (maximum 0 (minimum ((b * 255) / avg) 255))
  _planetX_colorHue = ('_planetX_colorHueFromRGB' _planetX_colorR _planetX_colorG _planetX_colorB)
  if (or (and (and (and _planetX_colorNewMode (_planetX_colorHue >= 180)) (_planetX_colorHue <= 201)) (and (temp_c >= 6000) ((temp_b - temp_g) < 1000))) (and (temp_r > 4096) (and (temp_g > 4096) (temp_b > 4096)))) {
    temp_c = ((temp_c * 13000) / 15000)
    _planetX_colorHue = (180 + ((13000 - temp_c) / 1000))
  }
  return _planetX_colorHue
}

to checkColor color {
  local 'hue' (readColor)
  if (or (color == 'red') (color == '红色')) {
    return (or (hue > 330) (hue < 20))
  }
  if (or (color == 'green') (color == '绿色')) {
    return (and (hue > 120) (180 > hue))
  }
  if (or (color == 'blue') (color == '蓝色')) {
    return (and (hue > 210) (270 > hue))
  }
  if (or (color == 'cyan') (color == '青色')) {
    return (and (hue > 190) (210 > hue))
  }
  if (or (color == 'magenta') (color == '洋红')) {
    return (and (hue > 260) (330 > hue))
  }
  if (or (color == 'yellow') (color == '黄色')) {
    return (and (hue > 30) (120 > hue))
  }
  return ('_planetX_colorIsWhite')
}

