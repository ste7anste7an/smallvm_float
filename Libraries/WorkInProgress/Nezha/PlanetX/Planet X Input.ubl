to '_planetX_ds18b20Address' pin {
  '[1wire:init]' pin
  '[1wire:scanStart]'
  waitMillis 10
  local 'addr' ('[data:newByteArray]' 8)
  if (not ('[1wire:scanNext]' addr)) {
    return 0
  }
  local 'family' (at 1 addr)
  if (not (or (family == 34) (or (family == 40) (family == 66)))) {
    return 0
  }
  return addr
}

to '_planetX_ds18b20Raw' pin {
  local 'addr' ('_planetX_ds18b20Address' pin)
  if (addr == 0) {
    return 0
  }
  '[1wire:select]' addr
  '[1wire:writeByte]' (hexToInt '44') true
  waitMillis 750
  '[1wire:select]' addr
  '[1wire:writeByte]' (hexToInt 'BE')
  local 'dataBytes' ('[data:newByteArray]' 9)
  for i 9 {
    atPut i dataBytes ('[1wire:readByte]')
