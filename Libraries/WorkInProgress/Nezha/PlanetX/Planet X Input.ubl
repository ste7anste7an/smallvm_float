to '_planetX_wsRead' reg {
  if ('_planetX_rfidExpired') {return -1}
  local 'buf' ('[data:newByteArray]' 1 0)
  comment 'Match the official WS1850 driver: STOP after the register address.'
  '[sensors:i2cWrite]' 40 ('[data:makeList]' reg) true
  if (('[sensors:i2cRead]' 40 buf) != 1) {
    return -1
  }
  return (at 1 buf)
}

to '_planetX_wsReadBlock' {
  local 'data' ('_planetX_wsWithCRC' ('[data:makeList]' 48 8))
  if ((size data) != 4) {
    return false
  }
  if (not ('_planetX_wsToCard' 12 data)) {
    return false
  }
  if (_planetX_rfidRetCount != 16) {
    return false
  }
  _planetX_rfidBlock = ('[data:copyFromTo]' _planetX_wsResponse 1 16)
  return true
}

to '_planetX_wsReadFifo' {
  local 'count' ('_planetX_wsRead' 10)
  local 'control' ('_planetX_wsRead' 12)
  if (or (count < 0) (control < 0)) {
    return false
  }
  local 'lastBits' (control & 7)
  _planetX_rfidRetBits = (count * 8)
  if (and (count > 0) (lastBits > 0)) {
    _planetX_rfidRetBits = (((count - 1) * 8) + lastBits)
  }
  _planetX_rfidRetCount = (minimum 16 (maximum 1 count))
  _planetX_wsResponse = ('[data:newByteArray]' _planetX_rfidRetCount 0)
  for i _planetX_rfidRetCount {
    local 'value' ('_planetX_wsRead' 9)
    if (value < 0) {
      return false
    }
    atPut i _planetX_wsResponse value
  }
  return true
}

to '_planetX_wsRequest' {
  if (not ('_planetX_wsWrite' 13 7)) {return false}
  if (not ('_planetX_wsToCard' 12 ('[data:makeList]' 38))) {return false}
  return (_planetX_rfidRetBits == 16)
}

to '_planetX_wsSelect' {
  local 'data' ('[data:newByteArray]' 7 0)
  atPut 1 data 147
  atPut 2 data 112
  for i 5 {
    atPut (i + 2) data (at i _planetX_rfidUid)
  }
  data = ('_planetX_wsWithCRC' data)
  if ((size data) != 9) {
    return false
  }
  if (not ('_planetX_wsToCard' 12 data)) {
    return false
  }
  return (_planetX_rfidRetBits == 24)
}

to '_planetX_wsToCard' command data {
  _planetX_rfidRetBits = 0
  _planetX_rfidRetCount = 0
  _planetX_wsResponse = ('[data:newByteArray]' 0)
  if (not ('_planetX_wsPrepare' command data)) {
    return false
  }
  local 'mask' 49
  if (command == 14) {
    mask = 17
  }
  local 'irq' ('_planetX_wsWaitIRQ' 4 mask 1000)
  if (command == 12) {
    '_planetX_wsBits' 13 128 false
  }
  if (or (irq < 0) ((irq & 1) != 0)) {
    return false
  }
  local 'error' ('_planetX_wsRead' 6)
  if (or (error < 0) ((error & 27) != 0)) {
    return false
  }
  if (command == 14) {
    return true
  }
  return ('_planetX_wsReadFifo')
}

to '_planetX_wsUid' {
  if (not ('_planetX_wsWrite' 13 0)) {return false}
  if (not ('_planetX_wsToCard' 12 ('[data:makeList]' 147 32))) {return false}
  if (_planetX_rfidRetCount != 5) {return false}
  local 'checksum' 0
  local 'present' false
  for i 4 {
    checksum = (checksum ^ (at i _planetX_wsResponse))
    if ((at i _planetX_wsResponse) != 0) {
      present = true
    }
  }
  if (or (not present) (checksum != (at 5 _planetX_wsResponse))) {
    return false
  }
  _planetX_rfidUid = ('[data:copyFromTo]' _planetX_wsResponse 1 5)
  return true
}

to '_planetX_wsWaitIRQ' reg mask attempts {
  repeat attempts {
    local 'irq' ('_planetX_wsRead' reg)
    if (irq < 0) {
      return -1
    }
    if ((irq & mask) != 0) {
      return irq
    }
    if ('_planetX_rfidExpired') {
      return -1
    }
    waitMillis 1
  }
  return -1
}

to '_planetX_wsWithCRC' data {
  if (not ('_planetX_wsBits' 5 4 false)) {return ('[data:newByteArray]' 0)}
  if (not ('_planetX_wsBits' 10 128 true)) {return ('[data:newByteArray]' 0)}
  for byte data {
    if (not ('_planetX_wsWrite' 9 byte)) {return ('[data:newByteArray]' 0)}
  }
  if (not ('_planetX_wsWrite' 1 3)) {
    return ('[data:newByteArray]' 0)
  }
  if (('_planetX_wsWaitIRQ' 5 4 255) < 0) {
    return ('[data:newByteArray]' 0)
  }
  local 'low' ('_planetX_wsRead' 34)
  local 'high' ('_planetX_wsRead' 33)
  if (or (low < 0) (high < 0)) {
    return ('[data:newByteArray]' 0)
  }
  local 'out' ('[data:newByteArray]' ((size data) + 2) 0)
  for i (size data) {
    atPut i out (at i data)
  }
  atPut ((size data) + 1) out low
  atPut ((size data) + 2) out high
  return out
}

to '_planetX_wsWrite' reg value {
  if ('_planetX_rfidExpired') {return false}
  '[sensors:i2cWrite]' 40 ('[data:makeList]' reg value)
  return true
}

to '_planetX_wsWriteBlock' {
  local 'data' ('_planetX_wsWithCRC' ('[data:makeList]' 160 8))
  if ((size data) != 4) {
    return false
  }
  if (not ('_planetX_wsAck' data)) {
    return false
  }
  data = ('_planetX_wsWithCRC' _planetX_rfidWrite)
  if ((size data) != 18) {
    return false
  }
  return ('_planetX_wsAck' data)
}

to planetX_bme280Sensor state {
  if (not ('_planetX_bmeEnsure')) {return 0}
  '_planetX_bmeUpdateValues'
  if (or (state == 'temperature (°C)') (state == '温度(℃)')) {
    return _planetX_bmeTemperature
  }
  if (or (state == 'humidity (0-100%)') (state == '湿度(0~100%)')) {
    return _planetX_bmeHumidity
  }
  if (or (state == 'pressure (hPa)') (state == '气压(hPa)')) {
    return _planetX_bmePressure
  }
  if (or (state == 'altitude (m)') (state == '海拔(M)')) {
    return ((1022 - _planetX_bmePressure) * 9)
  }
  return 0
}

to planetX_buttonCD port button {
  return ('_planetX_buttonNow' port button)
}

to planetX_buttonEventBroadcast port button message {
  if (not (or (button == 'C') (button == 'D'))) {
    sayIt 'Planet X button must be C or D.' button
    stopTask
    return
  }
  local 'signal' 'A'
  if (button == 'D') {signal = 'B'}
  local 'pin' ('_planetX_pinForPort' port signal)
  if (_planetX_buttonListeners == 0) {_planetX_buttonListeners = ('[data:makeList]')}
  local 'entry' 0
  for listener _planetX_buttonListeners {
    if ((at 1 listener) == pin) {entry = listener}
  }
  if (entry == 0) {
    entry = ('[data:makeList]' pin message (not (digitalReadOp pin 'up')))
    '[data:addLast]' entry _planetX_buttonListeners
  } else {
    atPut 2 entry message
  }
  comment 'Starting the receiver again also resumes polling after the stop button.'
  sendBroadcast '_planetX_buttonEventLoop'
}

to planetX_crash port {
  return (not (digitalReadOp ('_planetX_pinForPort' port 'B') 'up'))
}

to planetX_dht11Sensor port state {
  local 'pin' ('_planetX_pinForPort' port 'B')
  if (or (state == 'humidity (0-100)') (state == '湿度(0-100)')) {
    return ('_planetX_humidityDHT11' pin)
  }
  return ('_planetX_temperatureDHT11' pin)
}

to planetX_ds18b20Temp port unit {
  local 'tempC' (('_planetX_ds18b20Raw' ('_planetX_pinForPort' port 'B')) / 16)
  if (or (unit == 'Fahrenheit') (unit == '华氏度')) {
    return (((tempC * 18) / 10) + 32)
  }
  return tempC
}

to planetX_dust port {
  local 'voPin' ('_planetX_analogPinForPort' port)
  local 'ledPin' ('_planetX_pinForPort' port 'B')
  digitalWriteOp ledPin false
  waitMicros 160
  local 'raw' (analogReadOp voPin)
  waitMicros 100
  digitalWriteOp ledPin true
  waitMillis 10
  local 'mv' ('[misc:rescale]' raw 0 1023 0 4650)
  local 'dust' (((mv - 380) * 5) / 29)
  return (maximum 0 dust)
}

to planetX_gasValue port gasType {
  local 'value' (analogReadOp ('_planetX_analogPinForPort' port))
  if (or (gasType == 'carbon dioxide') (gasType == '二氧化碳')) {
    return (1024 - value)
  }
  return value
}

to planetX_lightSensor port {
  local 'pin' ('_planetX_analogPinForPort' port)
  local 'value' 0
  for i 100 {
    value += (analogReadOp pin)
  }
  value = (value / 100)
  if (value < 200) {
    value = ('[misc:rescale]' value 0 200 0 1600)
  } else {
    value = ('[misc:rescale]' value 200 1023 1600 14000)
  }
  return (maximum 0 value)
}

to planetX_noiseSensor port {
  local 'pin' ('_planetX_analogPinForPort' port)
  local 'baseline' 0
  for i 200 {
    baseline += (analogReadOp pin)
  }
  baseline = (baseline / 200)
  local 'sumHigh' 0
  local 'sumLow' 0
  local 'countHigh' 0
  local 'countLow' 0
  for i 200 {
    local 'sample' (analogReadOp pin)
    if (sample >= baseline) {
      sumHigh += sample
      countHigh += 1
    } else {
      sumLow += sample
      countLow += 1
    }
  }
  if (countHigh > 0) {
    sumHigh = (sumHigh / countHigh)
  } else {
    sumHigh = baseline
  }
  if (countLow > 0) {
    sumLow = (sumLow / countLow)
  } else {
    sumLow = baseline
  }
  local 'noise' (sumHigh - sumLow)
  if (noise <= 4) {
    noise = ('[misc:rescale]' noise 0 4 30 50)
  } (noise <= 8) {
    noise = ('[misc:rescale]' noise 4 8 50 55)
  } (noise <= 14) {
    noise = ('[misc:rescale]' noise 9 14 55 60)
  } (noise <= 32) {
    noise = ('[misc:rescale]' noise 15 32 60 70)
  } (noise <= 60) {
    noise = ('[misc:rescale]' noise 33 60 70 75)
  } (noise <= 100) {
    noise = ('[misc:rescale]' noise 61 100 75 80)
  } (noise <= 150) {
    noise = ('[misc:rescale]' noise 101 150 80 85)
  } (noise <= 231) {
    noise = ('[misc:rescale]' noise 151 231 85 90)
  } else {
    noise = ('[misc:rescale]' noise 231 1023 90 120)
  }
  return noise
}

to planetX_pir port {
  return (digitalReadOp ('_planetX_pinForPort' port 'B'))
}

to planetX_pm25 port {
  local 'pin' ('_planetX_pinForPort' port 'B')
  '[sensors:captureStart]' pin
  local 'start' (millisOp)
  repeatUntil (or (('[sensors:captureCount]') >= 3) ((millisSince start) > 1000)) {
    waitMillis 1
  }
  local 'pulses' ('[sensors:captureEnd]')
  if ((size pulses) < 2) {
    return 0
  }
  local 'pulseWidth' (at 2 pulses)
  if (pulseWidth < 0) {
    return 0
  }
  return pulseWidth
}

to planetX_rfidDetectCard {
  return ('_planetX_rfidRun' 0 '')
}

to planetX_rfidReadData {
  return ('_planetX_rfidRun' 1 '')
}

to planetX_rfidWriteData text {
  return ('_planetX_rfidRun' 2 text)
}

to planetX_rtcReadData data {
  if (not ('_planetX_rtcEnsure')) {return 0}
  if (or (data == 'year') (data == '年')) {return ((minimum ('_planetX_rtcHexToDec' ('_planetX_rtcReadReg' 6)) 99) + 2000)}
  if (or (data == 'month') (data == '月')) {return (maximum (minimum ('_planetX_rtcHexToDec' ('_planetX_rtcReadReg' 5)) 12) 1)}
  if (or (data == 'day') (data == '日')) {return (maximum (minimum ('_planetX_rtcHexToDec' ('_planetX_rtcReadReg' 4)) 31) 1)}
  if (or (data == 'weekday') (data == '星期')) {return (maximum (minimum ('_planetX_rtcHexToDec' ('_planetX_rtcReadReg' 3)) 7) 1)}
  if (or (data == 'hour') (data == '时')) {return (minimum ('_planetX_rtcHexToDec' ('_planetX_rtcReadReg' 2)) 23)}
  if (or (data == 'minute') (data == '分')) {return (minimum ('_planetX_rtcHexToDec' ('_planetX_rtcReadReg' 1)) 59)}
  if (or (data == 'seconds') (data == '秒')) {return (minimum ('_planetX_rtcHexToDec' ('_planetX_rtcReadReg' 0)) 59)}
  return 0
}

to planetX_rtcSetData num data {
  if (not ('_planetX_rtcEnsure')) {return}
  if (or (data == 'year') (data == '年')) {'_planetX_rtcWriteReg' 6 ('_planetX_rtcDecToHex' (num % 100))}
  if (or (data == 'month') (data == '月')) {'_planetX_rtcWriteReg' 5 ('_planetX_rtcDecToHex' (num % 13))}
  if (or (data == 'day') (data == '日')) {'_planetX_rtcWriteReg' 4 ('_planetX_rtcDecToHex' (num % 32))}
  if (or (data == 'weekday') (data == '星期')) {'_planetX_rtcWriteReg' 3 ('_planetX_rtcDecToHex' (num % 8))}
  if (or (data == 'hour') (data == '时')) {'_planetX_rtcWriteReg' 2 ('_planetX_rtcDecToHex' (num % 24))}
  if (or (data == 'minute') (data == '分')) {'_planetX_rtcWriteReg' 1 ('_planetX_rtcDecToHex' (num % 60))}
  if (or (data == 'seconds') (data == '秒')) {'_planetX_rtcWriteReg' 0 ('_planetX_rtcDecToHex' (num % 60))}
  '_planetX_rtcStart'
}

to planetX_soilHumidity port {
  local 'value' ('[misc:rescale]' (analogReadOp ('_planetX_analogPinForPort' port)) 0 1023 0 100)
  return (maximum 0 (minimum (100 - value) 100))
}

to planetX_trackBitChannelState channel state {
  if (not ('_planetX_trackBitEnsure')) {return false}
  local 'tempVal' ('_planetX_trackBitReadRaw' 4)
  if (tempVal < 0) {
    _planetX_trackBitReady = false
    _planetX_trackBitStateValid = false
    return false
  }
  local 'mask' (1 << ('_planetX_trackBitChannelIndex' channel))
  if (state == '1') {
    return ((tempVal & mask) != 0)
  }
  return ((tempVal & mask) == 0)
}

to planetX_trackBitGray channel {
  if (not ('_planetX_trackBitEnsure')) {return 0}
  local 'grayValue' ('_planetX_trackBitReadRaw' ('_planetX_trackBitChannelIndex' channel))
  if (grayValue < 0) {
    _planetX_trackBitReady = false
    _planetX_trackBitStateValid = false
    return 0
  }
  return grayValue
}

to planetX_trackBitOffset {
  if (not ('_planetX_trackBitEnsure')) {return 0}
  local 'offsetHigh' ('_planetX_trackBitReadRaw' 5)
  local 'offsetLow' ('_planetX_trackBitReadRaw' 6)
  if (or (offsetHigh < 0) (offsetLow < 0)) {
    _planetX_trackBitReady = false
    _planetX_trackBitStateValid = false
    return 0
  }
  local 'offset' ((offsetHigh << 8) + offsetLow)
  return (offset - 3000)
}

to planetX_trackBitState pattern {
  local 'stateValue' (planetX_trackBitStateValue)
  return (and _planetX_trackBitStateValid (stateValue == ('_planetX_trackBitPatternCode' pattern)))
}

to planetX_trackBitStateValue {
  if (not ('_planetX_trackBitEnsure')) {
    _planetX_trackBitStateValid = false
    return 0
  }
  local 'stateValue' ('_planetX_trackBitReadRaw' 4)
  if (stateValue < 0) {
    _planetX_trackBitReady = false
    _planetX_trackBitStateValid = false
    return 0
  }
  _planetX_trackBitStateValue = (stateValue & 15)
  _planetX_trackBitStateValid = true
  waitMillis 5
  return _planetX_trackBitStateValue
}

to planetX_trackingSensor port state {
  local 'leftPin' ('_planetX_pinForPort' port 'A')
  local 'rightPin' ('_planetX_pinForPort' port 'B')
  local 'leftBlack' (not (digitalReadOp leftPin 'up'))
  local 'rightBlack' (not (digitalReadOp rightPin 'up'))
  if (and leftBlack (and rightBlack (or (state == '00') (state == '● ●')))) {
    return true
  } (and leftBlack (and (not rightBlack) (or (state == '01') (state == '● ◌')))) {
    return true
  } (and (not leftBlack) (and rightBlack (or (state == '10') (state == '◌ ●')))) {
    return true
  } (and (not leftBlack) (and (not rightBlack) (or (state == '11') (state == '◌ ◌')))) {
    return true
  }
  return false
}

to planetX_trimpot port {
  return (analogReadOp ('_planetX_analogPinForPort' port))
}

to '_planetX_sr04PulseWidth' trig echo polling {
  comment 'Configure echo before triggering; wait for an old echo to finish.'
  digitalWriteOp trig false
  local 'start' (millisOp)
  repeatUntil (not (digitalReadOp echo 'none')) {
    if ((millisSince start) > 25) {return 0}
  }
  if (not polling) {'[sensors:captureStart]' echo}
  waitMicros 2
  digitalWriteOp trig true
  comment '10 us stays in the VM busy wait; 50 us yields to other tasks.'
  waitMicros 10
  digitalWriteOp trig false
  start = (millisOp)
  if polling {
    comment 'Nordic interrupt capture is unreliable on some edge pins. Read GPIO directly.'
    repeatUntil (digitalReadOp echo 'none') {
      if ((millisSince start) > 25) {return 0}
    }
    local 'rise' (microsOp)
    repeatUntil (not (digitalReadOp echo 'none')) {
      if ((microsSince rise) > 25000) {return 0}
    }
    return (microsSince rise)
  }
  repeatUntil (('[sensors:captureCount]') >= 2) {
    if ((millisSince start) > 25) {exitLoop}
    waitMillis 1
  }
  local 'pulses' ('[sensors:captureEnd]')
  if (not (isType pulses 'list')) {return 0}
  if ((size pulses) < 2) {return 0}
  if ((at 1 pulses) >= 0) {return 0}
  return (maximum 0 (at 2 pulses))
}

to planetX_ultrasoundSensor port unit {
  local 'trig' ('_planetX_pinForPort' port 'A')
  local 'echo' ('_planetX_pinForPort' port 'B')
  if (_planetX_sr04_cache == 0) {_planetX_sr04_cache = ('[data:makeList]')}
  local 'entry' 0
  for item _planetX_sr04_cache {
    if ((at 1 item) == trig) {entry = item}
  }
  if (entry == 0) {
    entry = ('[data:makeList]' trig 400 9 -61)
    '[data:addLast]' entry _planetX_sr04_cache
  }
  comment 'Allow 60 ms recovery after each read; 1 ms covers clock rounding.'
  local 'elapsed' (millisSince (at 4 entry))
  if (and (elapsed >= 0) (elapsed < 61)) {waitMillis (61 - elapsed)}
  local 'board' (boardType)
  local 'polling' (or (board == 'micro:bit') (board == 'micro:bit v2'))
  local 'width' ('_planetX_sr04PulseWidth' trig echo polling)
  atPut 4 entry (millisOp)
  _planetX_sr04_last = (at 2 entry)
  _planetX_sr04_misses = (at 3 entry)
  local 'distance' 400
  if (and (width > 0) (width <= 25000)) {
    _planetX_sr04_misses = 0
    _planetX_sr04_last = ((10 * width) / 583)
    distance = _planetX_sr04_last
    atPut 2 entry distance
  } else {
    _planetX_sr04_misses += 1
    if (_planetX_sr04_misses < 10) {distance = _planetX_sr04_last}
  }
  atPut 3 entry _planetX_sr04_misses
  if (or (or (unit == 'inch') (unit == '英尺')) (unit == '英寸')) {
    return (((distance * 100) + 127) / 254)
  }
  if (or (unit == 'mm') (unit == '毫米')) {return (distance * 10)}
  return distance
}

to planetX_uvLevel port {
  local 'value' (minimum (analogReadOp ('_planetX_analogPinForPort' port)) 625)
  return ('[misc:rescale]' value 0 625 0 15)
}

to planetX_waterLevel port optionalSpeed {
  local 'pin' ('_planetX_analogPinForPort' port)
  local 'speed' (argOrDefault 2 'fast')
  local 'sampleCount' 1
  local 'sampleDelay' 0
  if (or (speed == 'slow') (speed == '慢')) {
    sampleCount = 16
    sampleDelay = 4
  } (or (speed == 'medium') (speed == '中')) {
    sampleCount = 8
    sampleDelay = 2
  }
  local 'total' 0
  repeat sampleCount {
    total += (analogReadOp pin)
    if (sampleDelay > 0) {
      waitMillis sampleDelay
    }
  }
  local 'rawValue' (total / sampleCount)
  local 'value' ('[misc:rescale]' rawValue 50 600 0 100)
  return (maximum 0 (minimum value 100))
}



to _planetX_rfidSCLHigh {
  local 'start' (millisOp)
  repeatUntil (digitalReadOp 19 'up') {
    if ((millisSince start) >= 25) {
      _planetX_rfidClockOK = false
      return false
    }
    waitMicros 2
  }
  return true
}

to _planetX_rfidStartBus {
  local 'released' (digitalReadOp 20 'up')
  if (not (_planetX_rfidSCLHigh)) {return false}
  if (not (digitalReadOp 20 'up')) {return false}
  waitMicros 5
  digitalWriteOp 20 false
  comment 'Hold START for 200 us to allow PN532 I2C wakeup before the address.'
  waitMicros 200
  digitalWriteOp 19 false
  return true
}

to _planetX_rfidStopBus {
  digitalWriteOp 19 false
  digitalWriteOp 20 false
  local 'released' (_planetX_rfidSCLHigh)
  waitMicros 5
  released = (digitalReadOp 20 'up')
  waitMicros 5
}

to _planetX_rfidWriteByte byte {
  local 'mask' 128
  repeat 8 {
    if ((byte & mask) == 0) {
      digitalWriteOp 20 false
    } else {
      local 'released' (digitalReadOp 20 'up')
    }
    waitMicros 5
    if (not (_planetX_rfidSCLHigh)) {return false}
    waitMicros 5
    digitalWriteOp 19 false
    mask = (mask >> 1)
  }
  local 'released' (digitalReadOp 20 'up')
  waitMicros 5
  if (not (_planetX_rfidSCLHigh)) {return false}
  local 'ack' (not (digitalReadOp 20 'up'))
  digitalWriteOp 19 false
  return ack
}

to _planetX_rfidReadByte ack {
  local 'released' (digitalReadOp 20 'up')
  local 'byte' 0
  repeat 8 {
    waitMicros 5
    if (not (_planetX_rfidSCLHigh)) {return 255}
    byte = (byte << 1)
    if (digitalReadOp 20 'up') {byte += 1}
    digitalWriteOp 19 false
  }
  if ack {digitalWriteOp 20 false}
  waitMicros 5
  if (not (_planetX_rfidSCLHigh)) {return 255}
  waitMicros 5
  digitalWriteOp 19 false
  released = (digitalReadOp 20 'up')
  return byte
}

to _planetX_rfidRecover {
  _planetX_rfidClockOK = true
  local 'released' (digitalReadOp 20 'up')
  repeat 9 {
    digitalWriteOp 19 false
    waitMicros 5
    if (not (_planetX_rfidSCLHigh)) {return}
    waitMicros 5
  }
  _planetX_rfidStopBus
}

to _planetX_rfidFirmwareOK frame {
  if ((size frame) != 14) {return false}
  local 'header' ('[data:makeList]' 1 0 0 255 6 250 213 3 50)
  for i 9 {
    if ((at i frame) != (at i header)) {return false}
  }
  local 'checksum' 0
  for i 7 {checksum += (at (i + 6) frame)}
  return (and ((checksum & 255) == 0) ((at 14 frame) == 0))
}

to '_planetX_rfidBusRead' buffer {
  if (_planetX_rfidSoft == 0) {return ('[sensors:i2cRead]' 36 buffer)}
  atPut 'all' buffer 255
  if (not ('_planetX_rfidStartBus')) {
    '_planetX_rfidStopBus'
    return 0
  }
  if (not ('_planetX_rfidWriteByte' 73)) {
    '_planetX_rfidStopBus'
    return 0
  }
  for i (size buffer) {
    atPut i buffer ('_planetX_rfidReadByte' (i < (size buffer)))
    if (not _planetX_rfidClockOK) {exitLoop}
  }
  '_planetX_rfidStopBus'
  if (not _planetX_rfidClockOK) {return 0}
  return (size buffer)
}

to '_planetX_rfidBusWrite' frame {
  if (_planetX_rfidSoft == 0) {
    '[sensors:i2cWrite]' 36 frame true
    return true
  }
  if (not ('_planetX_rfidStartBus')) {
    '_planetX_rfidStopBus'
    return false
  }
  if (not ('_planetX_rfidWriteByte' 72)) {
    '_planetX_rfidStopBus'
    return false
  }
  for byte frame {
    if (not ('_planetX_rfidWriteByte' byte)) {
      '_planetX_rfidStopBus'
      return false
    }
  }
  '_planetX_rfidStopBus'
  return _planetX_rfidClockOK
}

to '_planetX_rfidSoftBegin' {
  if ((boardType) != 'micro:bit v2') {return false}
  if ('_planetX_rfidExpired') {return false}
  _planetX_rfidSoft = 1
  _planetX_rfidLastTransport = 1
  _planetX_rfidPhase = 'firmware'
  _planetX_rfidError = ''
  comment 'Park both idle TWIM signals on unused P0 to free P20/P19 without touching any J port.'
  '[sensors:i2cSetPins]' 0 0
  '_planetX_rfidRecover'
  if (not _planetX_rfidClockOK) {
    _planetX_rfidError = 'SCL timeout'
    return false
  }
  repeat 3 {
    if ('_planetX_rfidExpired') {
      _planetX_rfidError = 'operation timeout'
      return false
    }
    waitMillis 100
    if ('_planetX_rfidWriteAndRead' ('[data:makeList]' 0 0 255 2 254 212 2 42 0) 14) {
      if ('_planetX_rfidFirmwareOK' _planetX_rfidRecv) {
        _planetX_rfidPreferSoft = true
        _planetX_rfidError = ''
        return true
      }
      _planetX_rfidError = 'firmware frame'
    }
  }
  return false
}

to '_planetX_rfidSoftEnd' {
  if (_planetX_rfidSoft != 1) {return}
  '_planetX_rfidStopBus'
  '[sensors:i2cSetPins]' 20 19
  local 'released' (digitalReadOp 0)
  _planetX_rfidSoft = 0
  '_planetX_i2cSetClock'
}

to '_planetX_rfidTryPn' operation {
  if ('_planetX_rfidPnOperation' operation) {return true}
  if (or ((boardType) != 'micro:bit v2') (_planetX_rfidSoft == 1)) {return false}
  local 'transportError' (or (_planetX_rfidError == 'ACK timeout') (or (_planetX_rfidError == 'ACK frame') (_planetX_rfidError == 'response timeout')))
  comment 'Never replay a card write after its result becomes uncertain.'
  if (or (not transportError) (_planetX_rfidPhase == 'write8')) {return false}
  if (not ('_planetX_rfidSoftBegin')) {return false}
  return ('_planetX_rfidPnOperation' operation)
}
