}

to '_planetX_temperatureDHT11' pin {
  '_planetX_dhtUpdate' pin
  return _planetX_dht_temperature
}

to '_planetX_trackBitChannelIndex' channel {
  if (channel == '2') {return 1}
  if (channel == '3') {return 2}
  if (channel == '4') {return 3}
  return 0
}

to '_planetX_trackBitEnsure' {
