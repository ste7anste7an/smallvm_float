}

to '_planetX_trackBitPatternCode' pattern {
  if (pattern == '0000') {return 0}
  if (pattern == '0001') {return 8}
  if (pattern == '0010') {return 4}
  if (pattern == '0011') {return 12}
  if (pattern == '0100') {return 2}
  if (pattern == '0101') {return 10}
  if (pattern == '0110') {return 6}
  if (pattern == '0111') {return 14}
  if (pattern == '1000') {return 1}
  if (pattern == '1001') {return 9}
  if (pattern == '1010') {return 5}
  if (pattern == '1011') {return 13}
  if (pattern == '1100') {return 3}
  if (pattern == '1101') {return 11}
  if (pattern == '1110') {return 7}
  if (pattern == '1111') {return 15}
