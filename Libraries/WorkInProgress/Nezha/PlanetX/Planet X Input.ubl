      local 'newTemp' (at 3 _planetX_dhtData)
      local 'newHum' (at 1 _planetX_dhtData)
      if (newHum <= 100) {
        _planetX_dht_temperature = newTemp
        _planetX_dht_humidity = newHum
        atPut 2 entry newTemp
        atPut 3 entry newHum
      }
    }
  }
}

to '_planetX_divRound' value scale {
  if (value >= 0) {return ((value + (scale / 2)) / scale)}
  return ((value - (scale / 2)) / scale)
