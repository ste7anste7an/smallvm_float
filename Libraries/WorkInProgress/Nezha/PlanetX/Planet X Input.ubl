to '_planetX_analogPinForPort' port {
  local 'pin' ('_planetX_pinForPort' port 'A')
  local 'board' (boardType)
  if (and (or (board == 'micro:bit') (board == 'micro:bit v2')) (not (or (port == 'J1') (port == 'J2')))) {
    sayIt 'Planet X analog sensors require J1 or J2 on micro:bit.' port
    stopTask
    return -1
  }
  return pin
}

to '_planetX_buttonEventLoop' {
  forever {
    '_planetX_pollButtonEvents'
    waitMillis 10
  }
}

to '_planetX_pollButtonEvents' {
  if (_planetX_buttonListeners == 0) {return}
  for listener _planetX_buttonListeners {
    local 'pin' (at 1 listener)
    local 'pressed' (not (digitalReadOp pin 'up'))
    waitMillis 1
    if (pressed == (not (digitalReadOp pin 'up'))) {
      local 'wasPressed' (at 3 listener)
      atPut 3 listener pressed
      if (and pressed (not wasPressed)) {
        sendBroadcast (at 2 listener)
      }
    }
  }
}

to '_planetX_bmeEnsure' {
  '_planetX_extI2CInit'
  if _planetX_bmeReady {
    return true
  }
  if ('_planetX_bmeTryInit' 118) {
    return true
  }
  if ('_planetX_bmeTryInit' 119) {
    return true
  }
  return false
}

to '_planetX_bmeReadInt16LE' reg {
  return ('_planetX_bmeToInt16' ('_planetX_bmeReadUInt16LE' reg))
}

to '_planetX_bmeReadInt8' reg {
  return ('_planetX_bmeToInt8' ('_planetX_bmeReadReg' reg))
}

to '_planetX_bmeReadReg' reg {
  return ('_planetX_i2cReadReg' _planetX_bmeAddr reg)
}

to '_planetX_bmeReadUInt16LE' reg {
  return ('_planetX_i2cReadUInt16LE' _planetX_bmeAddr reg)
}

to '_planetX_bmeToInt12' value {
  if (value > 2047) {return (value - 4096)}
  return value
}

to '_planetX_bmeToInt16' value {
  if (value > 32767) {return (value - 65536)}
  return value
}

to '_planetX_bmeToInt8' value {
  if (value > 127) {return (value - 256)}
  return value
}

to '_planetX_bmeTryInit' addr {
  '_planetX_extI2CInit'
  _planetX_bmeAddr = addr
  if (or (addr < 1) (not ('_planetX_i2cExists' addr))) {
    return false
  }
  if (('_planetX_bmeReadReg' 208) != 96) {
    return false
  }
  _planetX_bmeDigT1 = ('_planetX_bmeReadUInt16LE' 136)
  _planetX_bmeDigT2 = ('_planetX_bmeReadInt16LE' 138)
  _planetX_bmeDigT3 = ('_planetX_bmeReadInt16LE' 140)
  _planetX_bmeDigP1 = ('_planetX_bmeReadUInt16LE' 142)
  _planetX_bmeDigP2 = ('_planetX_bmeReadInt16LE' 144)
  _planetX_bmeDigP3 = ('_planetX_bmeReadInt16LE' 146)
  _planetX_bmeDigP4 = ('_planetX_bmeReadInt16LE' 148)
  _planetX_bmeDigP5 = ('_planetX_bmeReadInt16LE' 150)
  _planetX_bmeDigP6 = ('_planetX_bmeReadInt16LE' 152)
  _planetX_bmeDigP7 = ('_planetX_bmeReadInt16LE' 154)
  _planetX_bmeDigP8 = ('_planetX_bmeReadInt16LE' 156)
  _planetX_bmeDigP9 = ('_planetX_bmeReadInt16LE' 158)
  _planetX_bmeDigH1 = ('_planetX_bmeReadReg' 161)
  _planetX_bmeDigH2 = ('_planetX_bmeReadInt16LE' 225)
  _planetX_bmeDigH3 = ('_planetX_bmeReadReg' 227)
  local 'e5' ('_planetX_bmeReadReg' 229)
  _planetX_bmeDigH4 = ('_planetX_bmeToInt12' ((('_planetX_bmeReadReg' 228) << 4) + (e5 % 16)))
  _planetX_bmeDigH5 = ('_planetX_bmeToInt12' ((('_planetX_bmeReadReg' 230) << 4) + (e5 >> 4)))
  _planetX_bmeDigH6 = ('_planetX_bmeReadInt8' 231)
  '_planetX_bmeWriteReg' 242 4
  '_planetX_bmeWriteReg' 244 47
  '_planetX_bmeWriteReg' 245 12
  '_planetX_bmeWriteReg' 244 47
  _planetX_bmeReady = true
  return true
}

to '_planetX_bmeUpdateValues' {
  local 'adc_T' (((('_planetX_bmeReadReg' 250) << 12) + (('_planetX_bmeReadReg' 251) << 4)) + (('_planetX_bmeReadReg' 252) >> 4))
  local 'var1' ((((adc_T >> 3) - (_planetX_bmeDigT1 << 1)) * _planetX_bmeDigT2) >> 11)
  local 'var2' ((((((adc_T >> 4) - _planetX_bmeDigT1) * ((adc_T >> 4) - _planetX_bmeDigT1)) >> 12) * _planetX_bmeDigT3) >> 14)
  local 't' (var1 + var2)
  _planetX_bmeTemperature = ('_planetX_divRound' (((t * 5) + 128) >> 8) 100)
  local 'pVar1' ((t >> 1) - 64000)
  local 'pBase' (pVar1 >> 2)
  local 'pVar2' (((pBase * pBase) >> 11) * _planetX_bmeDigP6)
  pVar2 = (pVar2 + ((pVar1 * _planetX_bmeDigP5) << 1))
  pVar2 = ((pVar2 >> 2) + (_planetX_bmeDigP4 << 16))
  pVar1 = ((((_planetX_bmeDigP3 * ((pBase * pBase) >> 13)) >> 3) + ((_planetX_bmeDigP2 * pVar1) >> 1)) >> 18)
  local 'pScale' (32768 + pVar1)
  pVar1 = (((pScale / 128) * _planetX_bmeDigP1) / 256)
  if (pVar1 == 0) {
    return
  }
  local 'adc_P' (((('_planetX_bmeReadReg' 247) << 12) + (('_planetX_bmeReadReg' 248) << 4)) + (('_planetX_bmeReadReg' 249) >> 4))
  local 'pDelta' ((1048576 - adc_P) - (pVar2 >> 12))
  local 'pRaw' ((pDelta * 625) / pVar1)
  pRaw = (pRaw * 10)
  pVar1 = ((_planetX_bmeDigP9 * (((pRaw >> 3) * (pRaw >> 3)) >> 13)) >> 12)
  pVar2 = (((pRaw >> 2) * _planetX_bmeDigP8) >> 13)
  _planetX_bmePressure = ('_planetX_divRound' (pRaw + (((pVar1 + pVar2) + _planetX_bmeDigP7) >> 4)) 100)
  _planetX_bmePressure = (_planetX_bmePressure - 4)
  local 'adc_H' ((('_planetX_bmeReadReg' 253) << 8) + ('_planetX_bmeReadReg' 254))
  local 'hVar' (t - 76800)
  local 'hA' (((adc_H * 1024) - (_planetX_bmeDigH4 * 65536)) - ((_planetX_bmeDigH5 * hVar) / 16))
  local 'hC1' (1024 + ((_planetX_bmeDigH3 * hVar) / 65536))
  local 'hC2' (1024 + ((((_planetX_bmeDigH6 * hVar) / 65536) * hC1) / 1024))
  local 'hB' ((_planetX_bmeDigH2 * hC2) / 65536)
  local 'hScaled' (((hA / 128) * hB) / 8)
  local 'hC3' (1024 - ((_planetX_bmeDigH1 * hScaled) / 524288))
  hScaled = ((hScaled * hC3) / 1024)
