to '_planetX_dhtReady' {
  local 'elapsed' ((millisOp) - _planetX_dhtLastReadTime)
  return (or (elapsed < 0) (elapsed > 2000))
}

to '_planetX_dhtUpdate' pin {
  comment 'Keep separate cached readings and sample intervals for each physical pin.'
  if (_planetX_dhtCache == 0) {_planetX_dhtCache = ('[data:makeList]')}
  local 'entry' 0
  for item _planetX_dhtCache {
    if ((at 1 item) == pin) {entry = item}
  }
  if (entry == 0) {
    entry = ('[data:makeList]' pin 0 0 -2001)
    '[data:addLast]' entry _planetX_dhtCache
  }
  _planetX_dht_temperature = (at 2 entry)
  _planetX_dht_humidity = (at 3 entry)
  _planetX_dhtLastReadTime = (at 4 entry)
