}

to '_planetX_buttonNow' port button {
  local 'pinC' ('_planetX_pinForPort' port 'A')
  local 'pinD' ('_planetX_pinForPort' port 'B')
  local 'cPressed' (not (digitalReadOp pinC 'up'))
  local 'dPressed' (not (digitalReadOp pinD 'up'))
  waitMillis 1
  cPressed = (not (digitalReadOp pinC 'up'))
  dPressed = (not (digitalReadOp pinD 'up'))
  if (button == 'C') {
    return cPressed
  } (button == 'D') {
    return dPressed
  }
  return (and cPressed dPressed)
}

to '_planetX_dhtCaptureData' pin {
  '[sensors:captureStart]' pin
  waitMillis 10
  local 'pulses' ('[sensors:captureEnd]')
  _planetX_dhtRawPulses = pulses
  if (not (isType pulses 'list')) {return false}
  local 'pulseCount' (size pulses)
  if (pulseCount < 80) {
    return false
  }
  if (pulseCount > 80) {
    pulses = ('[data:copyFromTo]' pulses (pulseCount - 79))
  }
  local 'byte' 0
  for i 40 {
    local 'high' (at ((2 * i) - 1) pulses)
    local 'low' (at (2 * i) pulses)
    if (or (or (high < 10) (high > 150)) (or (low >= 0) (low < -150))) {
      atPut 'all' _planetX_dhtData 1
      return false
    }
    if (high > 40) {byte += 1}
    if ((i % 8) == 0) {
      atPut (i / 8) _planetX_dhtData byte
      byte = 0
    } else {
      byte = (byte << 1)
    }
  }
  return true
}

to '_planetX_dhtChecksumOkay' {
  if (not (isType _planetX_dhtData 'list')) {return false}
  if ((size _planetX_dhtData) != 5) {return false}
  local 'checksum' 0
  for i 4 {
    checksum += (at i _planetX_dhtData)
  }
  checksum = (checksum & 255)
  return (checksum == (at 5 _planetX_dhtData))
}

to '_planetX_dhtReadData' pin {
  if (_planetX_dhtData == 0) {_planetX_dhtData = (newList 5)}
