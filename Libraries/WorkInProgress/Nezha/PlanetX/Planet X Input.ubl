    return true
  }
  if (not ('_planetX_i2cExists' 104)) {
    return false
  }
  _planetX_rtcReady = true
  return true
}

to '_planetX_rtcGetSecond' {
  return (minimum ('_planetX_rtcHexToDec' ('_planetX_rtcReadReg' 0)) 59)
}

to '_planetX_rtcHexToDec' value {
