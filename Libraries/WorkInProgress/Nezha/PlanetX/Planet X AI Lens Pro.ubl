    waitMillis 400
  }
  return false
}

to '_planetX_aiLensPro_wait_wifi_receipt' seq {
  local 'start' (millisOp)
  repeatUntil ((millisSince start) >= 3500) {
    if ('_planetX_aiLensPro_read_wifi_mailbox' -1 seq 650) {
      if (_planetX_aiLensPro_wifi_mailbox_type == 18) {return true}
      if (_planetX_aiLensPro_wifi_mailbox_type == 19) {return false}
    } else {
      waitMillis 80
    }
  }
  return false
}

to '_planetX_aiLensPro_wifi_header_matches' head expectedType expectedSeq {
  if ((size head) < 8) {return false}
  if (or ((at 1 head) != 165) ((at 2 head) != 1)) {return false}
  local 'type' (at 3 head)
  if (and (type != 17) (and (type != 18) (type != 19))) {
    return false
  }
  if (and (expectedType >= 0) (type != (expectedType & 255))) {
    return false
  }
  if (and (expectedSeq >= 0) ((at 4 head) != (expectedSeq & 255))) {
    return false
  }
  return ('_planetX_aiLensPro_valid_wifi_status' (at 5 head) (at 6 head) (((at 7 head) << 8) | (at 8 head)))
}

to '_planetX_aiLensPro_wifi_public_ready' {
  return (and (_planetX_aiLensPro_wifi_state == 4) ((_planetX_aiLensPro_wifi_flags & 4) != 0))
