      return id
    }
  }
  '_planetX_aiLensPro_offline'
  return -1
}

to '_planetX_aiLensPro_u16le' data offset {
  if ((offset + 1) > (size data)) {return 0}
  return (((at (offset + 1) data) << 8) | (at offset data))
}

to '_planetX_aiLensPro_uart_frame' command payload {
  if (payload == 0) {payload = ('[data:newByteArray]' 0)}
  payload = ('[data:asByteArray]' payload)
  local 'len' (size payload)
  local 'frame' ('[data:newByteArray]' (4 + len) 0)
  atPut 1 frame (hexToInt 'FF')
  atPut 2 frame (hexToInt 'F9')
  atPut 3 frame (command & 255)
  atPut 4 frame (len & 255)
  for i len {
    atPut (i + 4) frame (at i payload)
  }
  return frame
}

to '_planetX_aiLensPro_update_mode' appId {
  local 'id' (appId & 255)
  local 'supported' (or (id == 1) (id == (hexToInt '1B')))
  supported = (or supported (and (id >= (hexToInt '10')) (id <= (hexToInt '16'))))
  supported = (or supported (and (id >= (hexToInt '1E')) (id <= (hexToInt '27'))))
  if (not supported) {
    return false
  }
  _planetX_aiLensPro_current_mode = id
  return true
}

to '_planetX_aiLensPro_utf8_bytes_match' bytes text {
  local 'expected' ('[data:asByteArray]' text)
  if ((size expected) != (size bytes)) {
    return false
  }
  for i (size bytes) {
    if ((at i bytes) != (at i expected)) {return false}
  }
  return true
}

to '_planetX_aiLensPro_valid_wifi_status' state flags textLen {
  if (or (state < 0) (state > 5)) {return false}
  if ((flags & 240) != 0) {return false}
  if (or (textLen < 0) (textLen > 72)) {return false}
  if (and (state == 2) ((flags & 4) != 0)) {return false}
  if (and (state == 3) ((flags & 2) == 0)) {return false}
  if (and (state == 4) ((flags & 7) != 7)) {return false}
  if (and (state == 5) ((flags & 4) != 0)) {return false}
  return true
}

to '_planetX_aiLensPro_wait_wifi_ready' timeoutMS {
  local 'start' (millisOp)
  repeatUntil ((millisSince start) >= (maximum 1000 timeoutMS)) {
    '_planetX_aiLensPro_refresh_wifi_status' 600
    if ('_planetX_aiLensPro_wifi_public_ready') {
      return true
    }
    if (_planetX_aiLensPro_wifi_state == 5) {
      return false
