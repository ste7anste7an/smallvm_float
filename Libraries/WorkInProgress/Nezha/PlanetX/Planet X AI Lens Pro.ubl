  if (data == 'y coordinate') {
    return ('_planetX_aiLensPro_u16le' _planetX_aiLensPro_card_targets (offset + 5))
  }
  if (or (data == 'confidence (%)') (data == 'confidence')) {
    return (minimum 100 (at (offset + 2) _planetX_aiLensPro_card_targets))
  }
  if (data == 'size') {
    return ('_planetX_aiLensPro_u16le' _planetX_aiLensPro_card_targets (offset + 7))
  }
  return (at (offset + 1) _planetX_aiLensPro_card_targets)
}

to planetX_aiLensPro_set_color_recognition_mode mode {
  if (not ('_planetX_aiLensPro_ready')) {return false}
  local 'value' 0
  if (mode == 'recognize mode') {
    value = 1
  }
  local 'current' ('_planetX_aiLensPro_try_read_mode' 2)
  if (current < 0) {
    current = _planetX_aiLensPro_current_mode
  }
  if (current != (hexToInt '25')) {
    if (not ('_planetX_aiLensPro_switch_mode' (hexToInt '25') 2 6000)) {return false}
  }
  if (not ('_planetX_aiLensPro_send_uart_command' (hexToInt '44') ('[data:makeList]' value))) {
    return false
  }
  _planetX_aiLensPro_color_mode = value
  waitMillis 30
  '_planetX_aiLensPro_refresh_color'
  return true
}

to planetX_aiLensPro_set_flashlight state brightness {
  if (not ('_planetX_aiLensPro_ready')) {return false}
  brightness = (brightness | 0)
  if (or (or (state == 'off') (state == '关闭')) (brightness == 0)) {
    return ('_planetX_aiLensPro_send_uart_command' (hexToInt '46') ('[data:makeList]' 0 0))
  }
  brightness = (minimum 100 (maximum 5 brightness))
  return ('_planetX_aiLensPro_send_uart_command' (hexToInt '46') ('[data:makeList]' 1 brightness))
}

to planetX_aiLensPro_set_ocr_region x1 y1 x2 y2 {
  if (not ('_planetX_aiLensPro_ready')) {return false}
  return ('_planetX_aiLensPro_send_uart_command' (hexToInt '45') ('_planetX_aiLensPro_region_payload' x1 y1 x2 y2 480 640))
}

to planetX_aiLensPro_start_object_tracking x1 y1 x2 y2 {
  if (not ('_planetX_aiLensPro_ready')) {return false}
  local 'payload' ('_planetX_aiLensPro_region_payload' x1 y1 x2 y2 640 480)
  '_planetX_aiLensPro_clear_tracking_cache'
  return ('_planetX_aiLensPro_send_uart_command' (hexToInt '47') payload)
}

to planetX_aiLensPro_stop_object_tracking {
  if (not ('_planetX_aiLensPro_ready')) {return false}
  local 'result' ('_planetX_aiLensPro_send_uart_command' (hexToInt '47') ('[data:makeList]' 0))
  '_planetX_aiLensPro_clear_tracking_cache'
  return result
}

to planetX_aiLensPro_switch_to mode {
  if (not ('_planetX_aiLensPro_ready')) {return 0}
  return ('_planetX_aiLensPro_switch_mode' ('_planetX_aiLensPro_mode_id' mode) 3 6000)
}

to planetX_aiLensPro_tracking_target_value data {
  if (_planetX_aiLensPro_tracking_records < 1) {return 0}
  if (data == 'x coordinate') {return ('_planetX_aiLensPro_u16le' _planetX_aiLensPro_tracking_targets 4)}
  if (data == 'y coordinate') {return ('_planetX_aiLensPro_u16le' _planetX_aiLensPro_tracking_targets 6)}
  if (data == 'width') {return ('_planetX_aiLensPro_u16le' _planetX_aiLensPro_tracking_targets 8)}
  if (data == 'height') {return ('_planetX_aiLensPro_u16le' _planetX_aiLensPro_tracking_targets 10)}
  return (minimum 100 (at 2 _planetX_aiLensPro_tracking_targets))
}

