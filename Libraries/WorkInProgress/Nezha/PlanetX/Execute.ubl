module Execute Control
author 'Elecfreaks Team'
version 1 2
description 'laser
fan
LED
MP3'

choices ioAdcPort 'J1' 'J2' 'J3' 'J4'
choices planetXMP3Action 'play' 'stop' 'next track' 'previous track' 'pause'
variables _gpio_mp3Pin

  spec ' ' 'laserSensor' 'laser module _ turn _' 'menu.ioAdcPort bool' 'J1' true
  space
  spec ' ' 'planetX_motorFanSwitch' 'fan _ turn _' 'menu.ioAdcPort bool' 'J1' false
  space
  spec ' ' 'ledSwitch' 'LED _ turn _' 'menu.ioAdcPort bool' 'J1' true
  space
  spec ' ' 'MP3SetPort' 'MP3 set port _' 'menu.ioAdcPort' 'J1'
  spec ' ' 'setVolume' 'MP3 set volume _ (0-25)' 'num' 25
  spec ' ' 'folderPlay' 'MP3 play folder _ file _ : repeat _' 'num num bool' 1 1 false
  spec ' ' 'setTracking' 'MP3 play track _ : repeat _' 'num bool' 1 false
  spec ' ' 'setLoopFolder' 'MP3 loop folder _' 'num' 1
  spec ' ' 'MP3execute' 'MP3 execute _' 'menu.planetXMP3Action' 'play'

to 'planetX_motorFan' port on optionalSpeed {
  local 'speed' (argOrDefault 3 100)
  speed = (maximum 0 (minimum speed 100))
  local 'pin' 4
  if (port == 'J2') {
    pin = 6
  } (port == 'J3') {
    pin = 15
  } (port == 'J4') {
    pin = 17
  }
  if (and on (speed > 0)) {
    analogWriteOp pin ((1023 * speed) / 100)
  } else {
    analogWriteOp pin 0
    digitalWriteOp pin false
  }
}

// Product-facing switch selector; old projects retain their speed argument.
to 'planetX_motorFanSwitch' port on {
  'planetX_motorFan' port on 100
}

to ledBrightness port on optionalBrightness {
  local 'brightness' (argOrDefault 3 100)
  brightness = (maximum 0 (minimum brightness 100))
  local 'pin' 4
  if (port == 'J2') {
    pin = 6
  } (port == 'J3') {
    pin = 15
  } (port == 'J4') {
    pin = 17
  }
  if (and on (brightness > 0)) {
    analogWriteOp pin ((1023 * brightness) / 100)
  } else {
    analogWriteOp pin 0
    digitalWriteOp pin false
  }
}

// Product-facing switch selector; old projects retain their brightness argument.
to ledSwitch port on {
  ledBrightness port on 100
}

to laserSensor port on {
  local 'pin' 5
  if (port == 'J2') {
    pin = 7
  } (port == 'J3') {
    pin = 16
  } (port == 'J4') {
    pin = 18
  }
  digitalWriteOp pin on
}

to '_gpio_mp3Ensure' {
  if (_gpio_mp3Pin == 0) {
    _gpio_mp3Pin = 5
    '[elfreaks_dev_sensor:wifiUartInit]' 'J1' 9600
    waitMillis 50
  }
}

to '_gpio_mp3Send' cmd arg1 arg2 {
  '_gpio_mp3Ensure'
  arg1 = (maximum 0 (minimum arg1 255))
  arg2 = (maximum 0 (minimum arg2 255))
  local 'msg' ('[data:makeList]' (hexToInt '7E') (hexToInt 'FF') 6 cmd 0 arg1 arg2 0 0 (hexToInt 'EF'))
  local 'sum' 0
  for i 6 {
    sum += (at (i + 1) msg)
  }
  sum = (65536 - sum)
  atPut 8 msg ((sum >> 8) & 255)
  atPut 9 msg (sum & 255)
  '[elfreaks_dev_sensor:wifiUartWrite]' msg
  waitMillis 100
}

to MP3SetPort port {
  local 'pin' 5
  if (port == 'J2') {
    pin = 7
  } (port == 'J3') {
    pin = 16
  } (port == 'J4') {
    pin = 18
  }
  _gpio_mp3Pin = pin
  '[elfreaks_dev_sensor:wifiUartInit]' port 9600
  waitMillis 50
  setVolume 25
}

to setVolume volume {
  volume = (maximum 0 (minimum volume 25))
  '_gpio_mp3Send' (hexToInt '06') 0 volume
}

to folderPlay folderNum fileNum repeat {
  folderNum = (maximum 1 (minimum folderNum 99))
  fileNum = (maximum 1 (minimum fileNum 255))
  '_gpio_mp3Send' (hexToInt '0F') folderNum fileNum
  if repeat {
    '_gpio_mp3Send' (hexToInt '19') 0 0
  }
}

to setTracking tracking repeat {
  tracking = (maximum 1 (minimum tracking 255))
  '_gpio_mp3Send' (hexToInt '03') 0 tracking
  '_gpio_mp3Send' (hexToInt '0D') 0 0
  if repeat {
    '_gpio_mp3Send' (hexToInt '19') 0 0
  }
}

to setLoopFolder folderNum {
  folderNum = (maximum 1 (minimum folderNum 99))
  '_gpio_mp3Send' (hexToInt '17') 0 folderNum
}

to MP3execute action {
  local 'cmd' (hexToInt '0D')
  if (or (action == 'stop') (action == '停止')) {
    cmd = (hexToInt '16')
  } (or (or (action == 'next track') (action == '切换音乐')) (action == '下一首')) {
    cmd = (hexToInt '01')
  } (or (action == 'previous track') (action == '上一首')) {
    cmd = (hexToInt '02')
  } (or (action == 'pause') (action == '暂停')) {
    cmd = (hexToInt '0E')
  }
  '_gpio_mp3Send' cmd 0 0
}
