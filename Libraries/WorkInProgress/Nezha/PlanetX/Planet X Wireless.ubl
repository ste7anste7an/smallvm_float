module 'Planet X Wireless' Control
author 'Elecfreaks Team'
version 2 1 
depends '_Planet X Support' 
tags wifi smartiot network http joystick i2c 
choices planetXJoystickAxis RX RY LX LY 
choices planetXJoystickButton '⬆' '⬇' '⬅' '➡' '▷' '☐' '𐤏' '⨉' L1 R1 L2 R2 SELECT START L3 R3 
description 'ESP8266 WiFi
WIKI:
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05036

SmartIoT

I2C rocker
WIKI (joystick):
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05068/'
variables _planetX_wifiConnected _planetX_wifiLastResponse _planetX_smartiot_connected _planetX_smartiot_sendMsg _planetX_smartiot_lastSendTime _planetX_smartiot_switchListenFlag _planetX_smartiot_switchStatus _planetX_smartiot_switchKnown _planetX_smartiot_requestBusy _planetX_smartiot_switchOnEvent _planetX_smartiot_switchOffEvent _planetX_smartiot_host _planetX_smartiot_port _planetX_smartiot_token _planetX_smartiot_topic _planetX_smartiot_lastResponse 

  spec ' ' 'planetX_wifiInit' 'WiFi module set port _ baud rate _' 'menu.planetXPort num' 'J1' 115200
  spec ' ' 'planetX_wifiConnect' 'WiFi connect SSID _ password _' 'str str' 'your_ssid' 'your_password'
  spec ' ' 'planetX_wifiSendAT' 'WiFi send AT _ wait _ ms' 'str num' 'AT' 500
  spec 'r' 'planetX_wifiRead' 'WiFi read response'
  spec 'r' 'planetX_wifiConnected' 'wifi connected'
  space
  spec ' ' 'planetX_connectSmartiot' 'Connect SmartIoT with userToken _ topic _' 'str str' 'your User Token' '1'
  spec ' ' 'planetX_setSmartIotUploadData' 'set data to send SmartIoT Data 1 _ : Data 2 _ : Data 3 _ : Data 4 _ : Data 5 _ : Data 6 _ : Data 7 _ : Data 8 _' 'auto auto auto auto auto auto auto auto' 0 0 0 0 0 0 0 0
  spec ' ' 'planetX_uploadSmartIotData' 'Upload data to SmartIoT'
  spec 'r' 'planetX_smartiotConnected' 'smartiot connected'
  spec 'h' 'planetX_iotSwitchEvent' 'when SmartIoT switch is _' 'menu.planetXOnOff' 'on'
  spec 'r' 'planetX_smartIotSwitchState' 'SmartIoT switch is _' 'menu.planetXOnOff' 'on'
  space
  spec 'r' 'planetX_joystickButton' 'joystick button _ is pressed' 'menu.planetXJoystickButton' '⬆'
  spec 'r' 'planetX_joystickAnalog' 'joystick _ analog value' 'menu.planetXJoystickAxis' 'LX'
  spec 'r' '_planetX_wifiAppendRead' '_planetX_wifiAppendRead'
  spec 'r' '_planetX_wifiRequest' '_planetX_wifiRequest _ _ _' 'auto auto auto' 0 0 0
  spec 'r' '_planetX_wifiWaitFor' '_planetX_wifiWaitFor _ _' 'auto auto' 0 0
  spec 'r' '_planetX_wifiWriteAT' '_planetX_wifiWriteAT _' 'auto' 0
  spec 'r' '_planetX_attentionCode' '_planetX_attentionCode _' 'auto' 0
  spec 'r' '_planetX_attentionReadByte' '_planetX_attentionReadByte'
  spec 'r' '_planetX_attentionRequest' '_planetX_attentionRequest _' 'auto' 0
  spec 'r' '_planetX_attentionWaitReady' '_planetX_attentionWaitReady'
  spec 'r' '_planetX_joystickAnalogCode' '_planetX_joystickAnalogCode _' 'auto' 0
  spec 'r' '_planetX_smartiotATCommand' '_planetX_smartiotATCommand _' 'auto' 0
  spec 'r' '_planetX_smartiotATRequest' '_planetX_smartiotATRequest _ _ _' 'auto auto auto' 0 0 0
  spec ' ' '_planetX_smartiotEnsureDefaults' '_planetX_smartiotEnsureDefaults'
  spec ' ' '_planetX_smartiotStartSwitchLoop' '_planetX_smartiotStartSwitchLoop'
  spec 'r' '_planetX_smartiotStatusCommand' '_planetX_smartiotStatusCommand'
  spec ' ' '_planetX_smartiotSwitchLoop' '_planetX_smartiotSwitchLoop'
  spec ' ' '_planetX_smartiotUpdateSwitchFromResponse' '_planetX_smartiotUpdateSwitchFromResponse _ _' 'auto auto' 0 0

to '_planetX_attentionCode' button {
  if (button == '⬆') {return 5}
  if (button == '⬇') {return 7}
  if (button == '⬅') {return 8}
  if (button == '➡') {return 6}
  if (button == '▷') {return 13}
  if (button == '☐') {return 16}
  if (button == '𐤏') {return 14}
  if (button == '⨉') {return 15}
  if (button == 'L1') {return 11}
  if (button == 'R1') {return 12}
  if (button == 'L2') {return 9}
  if (button == 'R2') {return 10}
  if (button == 'SELECT') {return 1}
  if (button == 'START') {return 4}
  if (button == 'L3') {return 2}
  if (button == 'R3') {return 3}
  return 0
}

to '_planetX_attentionReadByte' {
  local 'response' ('[data:newByteArray]' 1 0)
  if (('[sensors:i2cRead]' 8 response) != 1) {
    return -1
  }
  return (at 1 response)
}

to '_planetX_attentionRequest' command {
  if (not ('_planetX_i2cAcquire')) {return -1}
  '[sensors:i2cSetClockSpeed]' 200000
  local 'value' -1
  if ('_planetX_attentionWaitReady') {
    '[sensors:i2cWrite]' 8 command
    value = ('_planetX_attentionReadByte')
  }
  '_planetX_i2cRelease'
  return value
}

to '_planetX_attentionWaitReady' {
  local 'start' (millisOp)
  repeatUntil (('_planetX_attentionReadByte') == 16) {
    if ((millisSince start) >= 250) {return false}
    waitMillis 1
  }
  return true
}

to '_planetX_joystickAnalogCode' axis {
  if (axis == 'RX') {return 25}
  if (axis == 'RY') {return 26}
  if (axis == 'LY') {return 28}
  return 27
}

to '_planetX_smartiotATCommand' path {
  '_planetX_smartiotEnsureDefaults'
  return ('[data:join]' 'AT+HTTPCLIENT=2,0,"' _planetX_smartiot_host ':' _planetX_smartiot_port path '",,,1')
}

to '_planetX_smartiotATRequest' command responseKey timeoutMSecs {
  '_planetX_wifiAppendRead'
  if (not _planetX_wifiConnected) {
    _planetX_smartiot_lastResponse = '0 Not Connected'
    return _planetX_smartiot_lastResponse
  }
  local 'lockStart' (millisOp)
  repeatUntil (not _planetX_smartiot_requestBusy) {
    if ((millisSince lockStart) >= timeoutMSecs) {
      _planetX_smartiot_lastResponse = '0 Request Busy'
      return _planetX_smartiot_lastResponse
    }
    waitMillis 10
  }
  _planetX_smartiot_requestBusy = true
  _planetX_smartiot_lastResponse = ('_planetX_wifiRequest' command responseKey timeoutMSecs)
  _planetX_smartiot_requestBusy = false
  if ((size _planetX_smartiot_lastResponse) == 0) {
    _planetX_smartiot_lastResponse = '0 No Response'
  }
  return _planetX_smartiot_lastResponse
}

to '_planetX_smartiotEnsureDefaults' {
  if (_planetX_smartiot_host == 0) {_planetX_smartiot_host = 'http://www.smartiot.space'}
  if (_planetX_smartiot_port == 0) {_planetX_smartiot_port = 8080}
  if (_planetX_smartiot_token == 0) {_planetX_smartiot_token = ''}
  if (_planetX_smartiot_topic == 0) {_planetX_smartiot_topic = ''}
  if (_planetX_smartiot_sendMsg == 0) {_planetX_smartiot_sendMsg = ''}
  if (_planetX_smartiot_lastResponse == 0) {_planetX_smartiot_lastResponse = ''}
}

to '_planetX_smartiotStartSwitchLoop' {
  '_planetX_smartiotEnsureDefaults'
  if (not _planetX_smartiot_switchListenFlag) {
    _planetX_smartiot_switchListenFlag = true
    sendBroadcast '_planetX_smartiotSwitchLoop'
  }
}

to '_planetX_smartiotStatusCommand' {
  return ('_planetX_smartiotATCommand' ('[data:join]' '/iot/iotTopic/getTopicStatus/' _planetX_smartiot_token '/' _planetX_smartiot_topic))
}

to '_planetX_smartiotSwitchLoop' {
  forever {
    '_planetX_wifiAppendRead'
    if (and _planetX_wifiConnected _planetX_smartiot_connected) {
      local 'response' ('_planetX_smartiotATRequest' ('_planetX_smartiotStatusCommand') '"code":200' 2000)
      '_planetX_smartiotUpdateSwitchFromResponse' response true
    } else {
      if (not _planetX_wifiConnected) {_planetX_smartiot_connected = false}
    }
    waitMillis 1000
  }
}

to '_planetX_smartiotUpdateSwitchFromResponse' response fireEvent {
  local 'newStatus' _planetX_smartiot_switchStatus
  local 'knownStatus' false
  if (('[data:find]' 'switchOn' response) > 0) {
    newStatus = true
    knownStatus = true
  } (('[data:find]' 'switchOff' response) > 0) {
    newStatus = false
    knownStatus = true
  }
  if knownStatus {
    if (and (and fireEvent _planetX_smartiot_switchKnown) (newStatus != _planetX_smartiot_switchStatus)) {if newStatus {
      _planetX_smartiot_switchOnEvent = true
    } else {
      _planetX_smartiot_switchOffEvent = true
    }}
    _planetX_smartiot_switchStatus = newStatus
    _planetX_smartiot_switchKnown = true
  }
}

to '_planetX_wifiAppendRead' {
  local 'newData' ('[data:convertType]' ('[elfreaks_dev_sensor:wifiUartRead]') 'string')
  if ((size newData) > 0) {
    _planetX_wifiLastResponse = ('[data:join]' _planetX_wifiLastResponse newData)
    if (or (('[data:find]' 'WIFI GOT IP' _planetX_wifiLastResponse) > 0) (('[data:find]' 'CONNECTED' _planetX_wifiLastResponse) > 0)) {
      _planetX_wifiConnected = true
    }
    if (or (('[data:find]' 'WIFI DISCONNECT' _planetX_wifiLastResponse) > 0) (('[data:find]' 'DISCONNECT' _planetX_wifiLastResponse) > 0)) {
      _planetX_wifiConnected = false
    }
  }
  return _planetX_wifiLastResponse
}

to '_planetX_wifiRequest' command responseKey timeoutMSecs {
  '_planetX_wifiAppendRead'
  _planetX_wifiLastResponse = ''
  if (not ('_planetX_wifiWriteAT' command)) {
    return ''
  }
  '_planetX_wifiWaitFor' responseKey timeoutMSecs
  '_planetX_wifiAppendRead'
  return _planetX_wifiLastResponse
}

to '_planetX_wifiWaitFor' key timeoutMSecs {
  local 'start' (millisOp)
  repeatUntil ((millisSince start) > timeoutMSecs) {
    '_planetX_wifiAppendRead'
    if (('[data:find]' key _planetX_wifiLastResponse) > 0) {
      return true
    }
    waitMillis 20
  }
  return false
}

to '_planetX_wifiWriteAT' command {
  local 'atcmd' ('[data:join]' command ('[data:unicodeString]' 13) ('[data:unicodeString]' 10))
  return ('[elfreaks_dev_sensor:wifiUartWrite]' atcmd)
}

to planetX_connectSmartiot userToken topic {
  '_planetX_smartiotEnsureDefaults'
  _planetX_smartiot_token = userToken
  _planetX_smartiot_topic = topic
  _planetX_smartiot_connected = false
  repeat 3 {
    local 'response' ('_planetX_smartiotATRequest' ('_planetX_smartiotStatusCommand') '"code":200' 2000)
    if (('[data:find]' '"code":200' response) > 0) {
      _planetX_smartiot_connected = true
      '_planetX_smartiotUpdateSwitchFromResponse' response false
      return
    }
    waitMillis 200
  }
}

to planetX_iotSwitchEvent state {
  '_planetX_smartiotStartSwitchLoop'
  if (state == 'on') {
    if _planetX_smartiot_switchOnEvent {
      _planetX_smartiot_switchOnEvent = false
      return true
    }
  } else {
    if _planetX_smartiot_switchOffEvent {
      _planetX_smartiot_switchOffEvent = false
      return true
    }
  }
  return false
}

to planetX_joystickAnalog axis {
  local 'value' ('_planetX_attentionRequest' ('_planetX_joystickAnalogCode' axis))
  if (value < 0) {
    return 0
  }
  if (or (axis == 'RY') (axis == 'LY')) {
    if (value != 0) {value += 1}
  } else {
    if (and (value != 128) (value != 0)) {value += 1}
  }
  return (value * 4)
}

to planetX_joystickButton button {
  local 'code' ('_planetX_attentionCode' button)
  if (code == 0) {
    return false
  }
  return (('_planetX_attentionRequest' code) == 1)
}

to planetX_setSmartIotUploadData n1 n2 n3 n4 n5 n6 n7 n8 {
  '_planetX_smartiotEnsureDefaults'
  local 'data1' (argOrDefault 1 0)
  local 'data2' (argOrDefault 2 0)
  local 'data3' (argOrDefault 3 0)
  local 'data4' (argOrDefault 4 0)
  local 'data5' (argOrDefault 5 0)
  local 'data6' (argOrDefault 6 0)
  local 'data7' (argOrDefault 7 0)
  local 'data8' (argOrDefault 8 0)
  local 'path' ('[data:join]' '/iot/iotTopicData/addTopicData?userToken=' _planetX_smartiot_token '&topicName=' _planetX_smartiot_topic '&data1=' data1 '&data2=' data2 '&data3=' data3 '&data4=' data4 '&data5=' data5 '&data6=' data6 '&data7=' data7 '&data8=' data8)
  _planetX_smartiot_sendMsg = ('_planetX_smartiotATCommand' path)
}

to planetX_smartIotSwitchState state {
  '_planetX_smartiotEnsureDefaults'
  if (or ((size _planetX_smartiot_token) == 0) ((size _planetX_smartiot_topic) == 0)) {
    return false
  }
  local 'response' ('_planetX_smartiotATRequest' ('_planetX_smartiotStatusCommand') '"code":200' 2000)
  if (('[data:find]' '"code":200' response) < 1) {
    return false
  }
  if (not (or (('[data:find]' 'switchOn' response) > 0) (('[data:find]' 'switchOff' response) > 0))) {
    return false
  }
  _planetX_smartiot_connected = true
  '_planetX_smartiotUpdateSwitchFromResponse' response false
  if (state == 'on') {
    return (_planetX_smartiot_switchStatus == true)
  }
  return (_planetX_smartiot_switchStatus == false)
}

to planetX_smartiotConnected {
  '_planetX_wifiAppendRead'
  if (not _planetX_wifiConnected) {
    _planetX_smartiot_connected = false
  }
  return (_planetX_smartiot_connected == true)
}

to planetX_uploadSmartIotData {
  '_planetX_smartiotEnsureDefaults'
  if (not _planetX_smartiot_connected) {
    return
  }
  if (_planetX_smartiot_sendMsg == 0) {
    return
  }
  if ((size _planetX_smartiot_sendMsg) == 0) {
    return
  }
  if (_planetX_smartiot_lastSendTime > 0) {
    local 'elapsed' (millisSince _planetX_smartiot_lastSendTime)
    if (elapsed < 1000) {
      waitMillis (1000 - elapsed)
    }
  }
  '_planetX_smartiotATRequest' _planetX_smartiot_sendMsg '"code":200' 3000
  _planetX_smartiot_lastSendTime = (millisOp)
}

to planetX_wifiConnect ssid password {
  _planetX_wifiConnected = false
  _planetX_smartiot_connected = false
  repeat 3 {
    local 'cmd' ('[data:join]' 'AT+CWJAP="' ssid '","' password '"')
    planetX_wifiSendAT cmd 200
    if ('_planetX_wifiWaitFor' 'WIFI GOT IP' 5000) {
      _planetX_wifiConnected = true
      return
    }
    if ('_planetX_wifiWaitFor' 'OK' 500) {
      _planetX_wifiConnected = true
      return
    }
    planetX_wifiSendAT 'AT+RST' 2000
    '_planetX_wifiWaitFor' 'ready' 2000
    planetX_wifiSendAT 'AT+CWMODE=1' 500
  }
}

to planetX_wifiConnected {
  '_planetX_wifiAppendRead'
  return (_planetX_wifiConnected == true)
}

to planetX_wifiInit port baudrate {
  _planetX_wifiConnected = false
  _planetX_wifiLastResponse = ''
  _planetX_smartiot_connected = false
  _planetX_smartiot_requestBusy = false
  '[elfreaks_dev_sensor:wifiUartInit]' port baudrate
  waitMillis 100
  local 'ignore' ('[elfreaks_dev_sensor:wifiUartRead]')
  planetX_wifiSendAT 'AT' 500
  planetX_wifiSendAT 'AT+CWMODE=1' 500
}

to planetX_wifiRead {
  return ('_planetX_wifiAppendRead')
}

to planetX_wifiSendAT command waitMSecs {
  _planetX_wifiLastResponse = ''
  if (not ('_planetX_wifiWriteAT' command)) {
    return
  }
  waitMillis waitMSecs
  '_planetX_wifiAppendRead'
}

