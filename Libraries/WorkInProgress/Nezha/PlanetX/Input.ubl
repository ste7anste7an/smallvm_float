  if (pattern == '0010') {return 4}
  if (pattern == '0011') {return 12}
  if (pattern == '0100') {return 2}
  if (pattern == '0101') {return 10}
  if (pattern == '0110') {return 6}
  if (pattern == '0111') {return 14}
  if (pattern == '1000') {return 1}
  if (pattern == '1001') {return 9}
