module 'Planet X Display' Output
author 'Elecfreaks Team'
version 2 3 
depends '_Planet X Support' 
choices planetXNeoColor red orange yellow green blue indigo violet purple white black 
choices planetXNeoMode 'RGB(GRB order)' RGBW 'RGB(RGB order)' 
choices planetXMatrixEmoji smile 'crying face' 'neutral face' heart 'check mark' cross 
description 'Nixie tube
WIKI (TM1637):
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05026

neopixel
WIKI:
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05015

OLED Display
WIKI:
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05016

dot-matrix display screen
WIKI (matrix):
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05029'
variables _planetX_tmClockPin _planetX_tmDataPin _planetX_tmBrightness _planetX_tmDigits _planetX_npPixels _planetX_npPin _planetX_npHasWhite _planetX_npRangeStart _planetX_npRangeLength _planetX_i2cReady _planetX_matrixReady _planetX_matrixBuf _planetX_oledReady _planetX_oledAddr _planetX_oledBusy _planetX_oledLines 

  spec ' ' 'planetX_tm1637Create' 'numeric display set port _' 'menu.planetXPort' 'J1'
  spec ' ' 'planetX_tm1637ShowNumber' 'numeric display show _ (0-9999)' 'num' 1234
  spec ' ' 'planetX_tm1637ShowDP' 'numeric display digit _ (1-4) decimal point show _' 'num bool' 2 true
  spec ' ' 'planetX_tm1637Clear' 'clear numeric display'
  space
  spec ' ' 'planetX_neopixelCreate' 'connect rainbow LED to _ : count _ mode _' 'menu.planetXPort num menu.planetXNeoMode' 'J1' 10 'RGB(GRB order)'
  spec ' ' 'planetX_neopixelAllSetColor' 'set rainbow LED color _' 'color'
  spec ' ' 'planetX_neopixelSetPixelColor' 'set rainbow LED pixel _ to _' 'num color' 1
  spec ' ' 'planetX_neopixelBrightness' 'rainbow LED brightness _' 'num' 64
  spec ' ' 'planetX_neopixelRainbowShow' 'rainbow LED show gradient color'
  spec ' ' 'planetX_neopixelShift' 'shift rainbow LED _' 'num' 1
  spec ' ' 'planetX_neopixelRotate' 'rotate rainbow LED _' 'num' 1
  spec ' ' 'planetX_neopixelClear' 'clear rainbow LED'
  spec ' ' 'planetX_neopixelRange' 'rainbow LED range start _ length _' 'num num' 1 5
  space
  spec 'r' 'planetX_neopixelRGB' 'color r _ g _ b _ (0-255)' 'num num num' 255 0 0
  spec 'r' 'planetX_neopixelHSL' 'color hue _ (0-360) saturation _ % brightness _ %' 'num num num' 180 100 50
  spec 'r' 'planetX_neopixelColor' 'rainbow LED color _' 'menu.planetXNeoColor' 'red'
  space
  spec ' ' 'planetX_oledShowText' 'OLED line _ show text _' 'num str' 1 'Hello'
  spec ' ' 'planetX_oledShowNumber' 'OLED line _ show number _' 'num num' 2 123456
  spec ' ' 'planetX_oledClear' 'clear OLED'
  space
  spec ' ' 'planetX_matrixDraw' 'matrix display coordinate X _ Y _' 'num num' 0 0
  spec ' ' 'planetX_matrixEmoji' '5x5 matrix display emoji _' 'menu.planetXMatrixEmoji' 'smile'
  spec ' ' 'planetX_matrixRefresh' 'refresh matrix display'
  spec ' ' 'planetX_matrixClear' 'clear matrix display'
  space
  spec 'r' '_planetX_colorFromRGB' '_planetX_colorFromRGB _ _ _' 'auto auto auto' 0 0 0
  spec ' ' '_planetX_neopixelRainbow' '_planetX_neopixelRainbow _ _' 'auto auto' 0 0
  space
  spec 'r' '_planetX_matrixCmd' '_planetX_matrixCmd _' 'auto' 0
  spec 'r' '_planetX_matrixEnsure' '_planetX_matrixEnsure'
  spec ' ' '_planetX_matrixSetPoint' '_planetX_matrixSetPoint _ _' 'auto auto' 0 0
  spec ' ' '_planetX_matrixSetRow' '_planetX_matrixSetRow _ _' 'auto auto' 0 0
  spec ' ' '_planetX_matrixShow' '_planetX_matrixShow'
  spec ' ' '_planetX_matrixShow5x5' '_planetX_matrixShow5x5 _ _ _ _ _' 'auto auto auto auto auto' 0 0 0 0 0
  space
  spec ' ' '_planetX_npEnsure' '_planetX_npEnsure'
  spec 'r' '_planetX_npIndex' '_planetX_npIndex _' 'auto' 0
  spec ' ' '_planetX_npUpdate' '_planetX_npUpdate'
  space
  spec ' ' '_planetX_tmDelay' '_planetX_tmDelay'
  spec ' ' '_planetX_tmEnsure' '_planetX_tmEnsure'
  spec ' ' '_planetX_tmRefresh' '_planetX_tmRefresh'
  spec 'r' '_planetX_tmSegmentsForNum' '_planetX_tmSegmentsForNum _' 'auto' 0
  spec ' ' '_planetX_tmShowSegments' '_planetX_tmShowSegments _ _' 'auto auto' 0 0
  spec ' ' '_planetX_tmStart' '_planetX_tmStart'
  spec ' ' '_planetX_tmStop' '_planetX_tmStop'
  spec 'r' '_planetX_tmValidDigitIndex' '_planetX_tmValidDigitIndex _' 'auto' 0
  spec ' ' '_planetX_tmWriteByte' '_planetX_tmWriteByte _' 'auto' 0
  space
  spec 'r' '_planetX_i2cPortWrite' '_planetX_i2cPortWrite _ _' 'auto auto' 0 0
  spec ' ' '_planetX_oledClearCore' '_planetX_oledClearCore'
  spec 'r' '_planetX_oledCmd' '_planetX_oledCmd _' 'auto' 0
  spec 'r' '_planetX_oledData' '_planetX_oledData _' 'auto' 0
  spec 'r' '_planetX_oledEnsure' '_planetX_oledEnsure'
  spec ' ' '_planetX_oledEnsureLines' '_planetX_oledEnsureLines'
  spec 'r' '_planetX_oledInitCore' '_planetX_oledInitCore'
  spec 'r' '_planetX_oledLineBuffer' '_planetX_oledLineBuffer _' 'str' ''
  spec ' ' '_planetX_oledLock' '_planetX_oledLock'
  spec 'r' '_planetX_oledProbeAddr' '_planetX_oledProbeAddr _' 'auto' 0
  spec ' ' '_planetX_oledPutChar' '_planetX_oledPutChar _' 'auto' 0
  spec 'r' '_planetX_oledPutCharToBuf' '_planetX_oledPutCharToBuf _ _ _' 'auto auto auto' 0 0 0
  spec 'r' '_planetX_oledRenderAllLinesCore' '_planetX_oledRenderAllLinesCore'
  spec ' ' '_planetX_oledSetText' '_planetX_oledSetText _ _' 'auto auto' 0 0
  spec ' ' '_planetX_oledUnlock' '_planetX_oledUnlock'
  spec 'r' '_planetX_oledWakeCore' '_planetX_oledWakeCore'
  spec ' ' '_planetX_oledWriteDataUnlocked' '_planetX_oledWriteDataUnlocked _ _' 'auto auto' 0 0
  spec 'r' '_planetX_oledWriteLineCore' '_planetX_oledWriteLineCore _ _' 'auto str' 0 ''

to '_planetX_colorFromRGB' r g b {
  r = (maximum 0 (minimum r 255))
  g = (maximum 0 (minimum g 255))
  b = (maximum 0 (minimum b 255))
  return (((r << 16) | (g << 8)) | b)
}

to '_planetX_i2cPortWrite' addr bytes {
  if (not ('_planetX_i2cAcquire')) {return false}
  '[sensors:i2cSetClockSpeed]' 200000
  local 'present' ('[sensors:i2cExists]' addr)
  if present {
    if (and ((size bytes) > 32) ((at 1 bytes) == 64)) {
      '_planetX_oledWriteDataUnlocked' addr bytes
    } else {
      '[sensors:i2cWrite]' addr bytes
    }
  }
  '_planetX_i2cRelease'
  return present
}

to '_planetX_matrixCmd' value {
  return ('_planetX_i2cPortWrite' 112 ('[data:makeList]' value))
}

to '_planetX_matrixEnsure' {
  if (not _planetX_i2cReady) {_planetX_i2cReady = ('_planetX_extI2CInit')}
  if (not _planetX_i2cReady) {return false}
  if (not _planetX_matrixReady) {
    _planetX_matrixBuf = ('[data:newByteArray]' 17 0)
    atPut 1 _planetX_matrixBuf 0
    if (not ('_planetX_matrixCmd' 33)) {
      return false
    }
    if (not ('_planetX_matrixCmd' 129)) {
      return false
    }
    if (not ('_planetX_matrixCmd' 239)) {
      return false
    }
    _planetX_matrixReady = true
  }
  return true
}

to '_planetX_matrixSetPoint' x y {
  if (not ('_planetX_matrixEnsure')) {return false}
  x = (maximum 0 (minimum x 15))
  y = (maximum 0 (minimum y 7))
  local 'byteIndex' (((y * 2) + 2) + (ifExpression (x < 8) 0 1))
  atPut byteIndex _planetX_matrixBuf ((at byteIndex _planetX_matrixBuf) | (1 << (x % 8)))
  return true
}

to '_planetX_matrixSetRow' y bits {
  if (not ('_planetX_matrixEnsure')) {return false}
  atPut ((2 * y) + 2) _planetX_matrixBuf (bits & 255)
  atPut ((2 * y) + 3) _planetX_matrixBuf ((bits >> 8) & 255)
  return true
}

to '_planetX_matrixShow' {
  if (not ('_planetX_matrixEnsure')) {return false}
  atPut 1 _planetX_matrixBuf 0
  return ('_planetX_i2cPortWrite' 112 _planetX_matrixBuf)
}

to '_planetX_matrixShow5x5' row1 row2 row3 row4 row5 {
  if (not ('_planetX_matrixEnsure')) {return}
  for i 8 {
    '_planetX_matrixSetRow' (i - 1) 0
  }
  '_planetX_matrixSetRow' 1 (row1 << 5)
  '_planetX_matrixSetRow' 2 (row2 << 5)
  '_planetX_matrixSetRow' 3 (row3 << 5)
  '_planetX_matrixSetRow' 4 (row4 << 5)
  '_planetX_matrixSetRow' 5 (row5 << 5)
  '_planetX_matrixShow'
}

to '_planetX_neopixelRainbow' optionalStartHue optionalEndHue {
  '_planetX_npEnsure'
  local 'startHue' (argOrDefault 1 1)
  local 'endHue' (argOrDefault 2 360)
  if (_planetX_npRangeLength <= 1) {
    atPut ('_planetX_npIndex' 1) _planetX_npPixels ('[misc:hsvColor]' startHue 100 100)
    '_planetX_npUpdate'
    return
  }
  local 'span' (endHue - startHue)
  for i _planetX_npRangeLength {
    atPut ('_planetX_npIndex' i) _planetX_npPixels ('[misc:hsvColor]' (startHue + ((span * (i - 1)) / (_planetX_npRangeLength - 1))) 100 100)
  }
  '_planetX_npUpdate'
}

to '_planetX_npEnsure' {
  if (_planetX_npPixels == 0) {planetX_neopixelCreate 'J1' 10 'RGB(GRB order)'}
  if (_planetX_npRangeStart == 0) {
    _planetX_npRangeStart = 1
    _planetX_npRangeLength = (size _planetX_npPixels)
  }
}

to '_planetX_npIndex' i {
  '_planetX_npEnsure'
  return ((_planetX_npRangeStart + i) - 1)
}

to '_planetX_npUpdate' {
  '_planetX_npEnsure'
  '[display:neoPixelSetPin]' _planetX_npPin _planetX_npHasWhite
  '[display:neoPixelSend]' _planetX_npPixels
  waitMicros 300
}

to '_planetX_oledClearCore' {
  for j 8 {
    '_planetX_oledSetText' (j - 1) 0
    repeat 16 {
      '_planetX_oledPutChar' ' '
    }
  }
  '_planetX_oledSetText' 0 0
}

to '_planetX_oledCmd' value {
  return ('_planetX_i2cPortWrite' _planetX_oledAddr ('[data:makeList]' 128 value))
}

to '_planetX_oledData' value {
  return ('_planetX_i2cPortWrite' _planetX_oledAddr ('[data:makeList]' 64 value))
}

to '_planetX_oledEnsure' {
  if (not ('_planetX_extI2CInit')) {return false}
  '_planetX_oledLock'
  if _planetX_oledReady {
    if ('_planetX_oledWakeCore') {
      if (not ('_planetX_oledRenderAllLinesCore')) {
        _planetX_oledReady = false
        '_planetX_oledUnlock'
        return false
      }
      '_planetX_oledUnlock'
      return true
    }
    _planetX_oledReady = false
  }
  if (not ('_planetX_oledProbeAddr' 60)) {
    if (not ('_planetX_oledProbeAddr' 61)) {
      '_planetX_oledUnlock'
      return false
    }
  }
  if (not ('_planetX_oledInitCore')) {
    '_planetX_oledUnlock'
    return false
  }
  _planetX_oledReady = true
  if (not ('_planetX_oledRenderAllLinesCore')) {
    _planetX_oledReady = false
    '_planetX_oledUnlock'
    return false
  }
  '_planetX_oledUnlock'
  return true
}

to '_planetX_oledEnsureLines' {
  if (_planetX_oledLines == 0) {
    _planetX_oledLines = (newList 8)
    atPut 'all' _planetX_oledLines ''
  }
}

to '_planetX_oledInitCore' {
  if (not ('_planetX_oledCmd' 174)) {return false}
  if (not ('_planetX_oledCmd' 64)) {return false}
  if (not ('_planetX_oledCmd' 164)) {return false}
  if (not ('_planetX_oledCmd' 166)) {return false}
  if (not ('_planetX_oledCmd' 32)) {return false}
  if (not ('_planetX_oledCmd' 2)) {return false}
  if (not ('_planetX_oledCmd' 161)) {return false}
  if (not ('_planetX_oledCmd' 200)) {return false}
  if (not ('_planetX_oledCmd' 141)) {return false}
  if (not ('_planetX_oledCmd' 20)) {return false}
  waitMillis 10
  return ('_planetX_oledCmd' 175)
}

to '_planetX_oledLineBuffer' text {
  local 'buf' ('[data:newByteArray]' 129 0)
  atPut 1 buf 64
  local 'idx' 2
  local 'col' 0
  for ch text {
    if (col < 16) {
      idx = ('_planetX_oledPutCharToBuf' ch buf idx)
      col += 1
    }
  }
  return buf
}

to '_planetX_oledLock' {
  repeatUntil (not _planetX_oledBusy) {
    waitMillis 1
  }
  _planetX_oledBusy = true
}

to '_planetX_oledProbeAddr' addr {
  _planetX_oledAddr = addr
  return ('_planetX_i2cPortWrite' _planetX_oledAddr ('[data:makeList]' 128 174))
}

to '_planetX_oledPutChar' ch {
  local 'columns' ('[misc:shapeforChar]' ch)
  '_planetX_oledData' 0
  if (columns != 0) {
    for i 5 {
      '_planetX_oledData' (at i columns)
    }
  } else {
    repeat 5 {
      '_planetX_oledData' 0
    }
  }
  '_planetX_oledData' 0
  '_planetX_oledData' 0
}

to '_planetX_oledPutCharToBuf' ch buf idx {
  local 'columns' ('[misc:shapeforChar]' ch)
  atPut idx buf 0
  idx += 1
  if (columns != 0) {
    for i 5 {
      atPut idx buf (at i columns)
      idx += 1
    }
  } else {
    repeat 5 {
      atPut idx buf 0
      idx += 1
    }
  }
  atPut idx buf 0
  idx += 1
  atPut idx buf 0
  return (idx + 1)
}

to '_planetX_oledRenderAllLinesCore' {
  '_planetX_oledEnsureLines'
  for row 8 {
    if (not ('_planetX_oledWriteLineCore' (row - 1) (at row _planetX_oledLines))) {return false}
  }
  return true
}

to '_planetX_oledSetText' row column {
  row = (maximum 0 (minimum row 7))
  column = (maximum 0 (minimum column 15))
  local 'x' (8 * column)
  '_planetX_oledCmd' (176 + row)
  '_planetX_oledCmd' (x & 15)
  '_planetX_oledCmd' (16 + ((x >> 4) & 15))
}

to '_planetX_oledUnlock' {
  _planetX_oledBusy = false
}

to '_planetX_oledWakeCore' {
  if (not ('_planetX_oledCmd' 64)) {return false}
  if (not ('_planetX_oledCmd' 164)) {return false}
  if (not ('_planetX_oledCmd' 166)) {return false}
  if (not ('_planetX_oledCmd' 32)) {return false}
  if (not ('_planetX_oledCmd' 2)) {return false}
  if (not ('_planetX_oledCmd' 161)) {return false}
  if (not ('_planetX_oledCmd' 200)) {return false}
  if (not ('_planetX_oledCmd' 141)) {return false}
  if (not ('_planetX_oledCmd' 20)) {return false}
  waitMillis 2
  return ('_planetX_oledCmd' 175)
}

to '_planetX_oledWriteDataUnlocked' addr bytes {
  local 'offset' 2
  repeatUntil (offset > (size bytes)) {
    local 'count' (minimum 31 (((size bytes) - offset) + 1))
    local 'packet' ('[data:newByteArray]' (count + 1) 0)
    atPut 1 packet 64
    for i count {
      atPut (i + 1) packet (at ((offset + i) - 1) bytes)
    }
    '[sensors:i2cWrite]' addr packet
    offset += count
  }
}

to '_planetX_oledWriteLineCore' row text {
  '_planetX_oledSetText' row 0
  return ('_planetX_i2cPortWrite' _planetX_oledAddr ('_planetX_oledLineBuffer' text))
}

to '_planetX_tmDelay' {
  waitMicros 10
}

to '_planetX_tmEnsure' {
  if (_planetX_tmClockPin == 0) {
    _planetX_tmClockPin = ('_planetX_jPortPin' 'J1' 'A')
    _planetX_tmDataPin = ('_planetX_jPortPin' 'J1' 'B')
    _planetX_tmBrightness = 7
    digitalWriteOp _planetX_tmClockPin false
    digitalWriteOp _planetX_tmDataPin false
  }
  if (_planetX_tmDigits == 0) {
    _planetX_tmDigits = (newList 4)
    atPut 'all' _planetX_tmDigits 0
  }
}

to '_planetX_tmRefresh' {
  '_planetX_tmEnsure'
  for i 4 {
    '_planetX_tmShowSegments' (at i _planetX_tmDigits) i
  }
}

to '_planetX_tmSegmentsForNum' n {
  if (or (n < 0) (n > 15)) {return 0}
  local 'i' ((3 * n) + 1)
  return (hexToInt ('[data:copyFromTo]' '3f,06,5b,4f,66,6d,7d,07,7f,6f,77,7c,39,5e,79,71' i (i + 1)))
}

to '_planetX_tmShowSegments' value index {
  '_planetX_tmStart'
  '_planetX_tmWriteByte' (hexToInt '44')
  '_planetX_tmStop'
  '_planetX_tmStart'
  '_planetX_tmWriteByte' ((hexToInt 'C0') | (4 - index))
  '_planetX_tmWriteByte' value
  '_planetX_tmStop'
  '_planetX_tmStart'
  '_planetX_tmWriteByte' ((hexToInt '88') + _planetX_tmBrightness)
  '_planetX_tmStop'
}

to '_planetX_tmStart' {
  digitalWriteOp _planetX_tmClockPin true
  digitalWriteOp _planetX_tmDataPin true
  digitalWriteOp _planetX_tmDataPin false
  digitalWriteOp _planetX_tmClockPin false
}

to '_planetX_tmStop' {
  digitalWriteOp _planetX_tmClockPin false
  digitalWriteOp _planetX_tmDataPin false
  digitalWriteOp _planetX_tmClockPin true
  digitalWriteOp _planetX_tmDataPin true
}

to '_planetX_tmValidDigitIndex' bit {
  return (and (and (bit >= 1) (bit <= 4)) ((bit % 1) == 0))
}

to '_planetX_tmWriteByte' byte {
  repeat 8 {
    digitalWriteOp _planetX_tmClockPin false
    if ((byte & 1) == 1) {
      digitalWriteOp _planetX_tmDataPin true
    } else {
      digitalWriteOp _planetX_tmDataPin false
    }
    '_planetX_tmDelay'
    digitalWriteOp _planetX_tmClockPin true
    byte = (byte >> 1)
    '_planetX_tmDelay'
  }
  digitalWriteOp _planetX_tmClockPin false
  digitalWriteOp _planetX_tmDataPin false
  digitalWriteOp _planetX_tmClockPin true
}

to planetX_matrixClear {
  if (not ('_planetX_matrixEnsure')) {return}
  for i 16 {
    atPut (i + 1) _planetX_matrixBuf 0
  }
  '_planetX_matrixShow'
}

to planetX_matrixDraw x y {
  '_planetX_matrixSetPoint' x y
  '_planetX_matrixShow'
}

to planetX_matrixEmoji emoji {
  if (or (emoji == 'crying face') (or (emoji == '哭脸') (or (emoji == 'sad') (emoji == '难过')))) {
    '_planetX_matrixShow5x5' 10 27 0 14 17
  } (or (emoji == 'neutral face') (or (emoji == '正常脸') (emoji == '平脸'))) {
    '_planetX_matrixShow5x5' 10 0 0 31 0
  } (or (emoji == 'heart') (or (emoji == '爱心') (emoji == '心'))) {
    '_planetX_matrixShow5x5' 10 31 31 14 4
  } (or (emoji == 'check mark') (or (emoji == '对钩') (emoji == '勾选'))) {
    '_planetX_matrixShow5x5' 1 2 20 8 0
  } (or (emoji == 'cross') (or (emoji == 'angry') (or (emoji == '交叉') (or (emoji == '叉') (emoji == '生气'))))) {
    '_planetX_matrixShow5x5' 17 10 4 10 17
  } else {
    '_planetX_matrixShow5x5' 10 0 17 14 0
  }
}

to planetX_matrixRefresh {
  '_planetX_matrixShow'
}

to planetX_neopixelAllSetColor color {
  '_planetX_npEnsure'
  for i _planetX_npRangeLength {
    atPut ('_planetX_npIndex' i) _planetX_npPixels color
  }
  '_planetX_npUpdate'
}

to planetX_neopixelBrightness brightness {
  brightness = (maximum 10 (minimum brightness 255))
  '[display:neoPixelSetMaxBrightness]' brightness
  '_planetX_npUpdate'
}

to planetX_neopixelClear {
  '_planetX_npEnsure'
  for i _planetX_npRangeLength {
    atPut ('_planetX_npIndex' i) _planetX_npPixels 0
  }
  '_planetX_npUpdate'
}

to planetX_neopixelColor c {
  if (or (c == 'orange') (c == '橙色')) {
    return ('_planetX_colorFromRGB' 255 128 0)
  } (or (c == 'yellow') (c == '黄色')) {
    return ('_planetX_colorFromRGB' 255 255 0)
  } (or (c == 'green') (c == '绿色')) {
    return ('_planetX_colorFromRGB' 0 255 0)
  } (or (c == 'blue') (c == '蓝色')) {
    return ('_planetX_colorFromRGB' 0 0 255)
  } (or (c == 'indigo') (c == '靛色')) {
    return ('_planetX_colorFromRGB' 75 0 130)
  } (or (c == 'violet') (c == '紫罗兰')) {
    return ('_planetX_colorFromRGB' 143 0 255)
  } (or (c == 'purple') (c == '紫色')) {
    return ('_planetX_colorFromRGB' 160 32 240)
  } (or (c == 'white') (c == '白色')) {
    return ('_planetX_colorFromRGB' 255 255 255)
  } (or (c == 'black') (c == '黑色')) {
    return 0
  }
  return ('_planetX_colorFromRGB' 255 0 0)
}

to planetX_neopixelCreate port optionalCount optionalMode {
  local 'count' (argOrDefault 2 10)
  local 'mode' (argOrDefault 3 'RGB(GRB order)')
  count = (maximum 1 count)
  local 'hasWhite' (mode == 'RGBW')
  '[display:neoPixelSetRGB]' (('[data:find]' 'RGB(RGB' mode) == 1)
  _planetX_npPin = ('_planetX_jPortPin' port 'B')
  _planetX_npHasWhite = hasWhite
  if (or (_planetX_npPixels == 0) (count != (size _planetX_npPixels))) {
    _planetX_npPixels = (newList count)
  }
  atPut 'all' _planetX_npPixels 0
  '[display:neoPixelSetPin]' _planetX_npPin _planetX_npHasWhite
  _planetX_npRangeStart = 1
  _planetX_npRangeLength = count
}

to planetX_neopixelHSL h s v {
  return ('[misc:hsvColor]' h s v)
}

to planetX_neopixelRGB r g b {
  r = (maximum 0 (minimum r 255))
  g = (maximum 0 (minimum g 255))
  b = (maximum 0 (minimum b 255))
  return (((r << 16) | (g << 8)) | b)
}

to planetX_neopixelRainbowShow {
  '_planetX_neopixelRainbow' 1 360
}

to planetX_neopixelRange start length {
  '_planetX_npEnsure'
  start = (maximum 1 (minimum start (size _planetX_npPixels)))
  length = (maximum 1 (minimum length (((size _planetX_npPixels) - start) + 1)))
  _planetX_npRangeStart = start
  _planetX_npRangeLength = length
}

to planetX_neopixelRotate offset {
  '_planetX_npEnsure'
  if (offset == 0) {
    return
  }
  if (offset > 0) {
    repeat offset {
      local 'last' (at ('_planetX_npIndex' _planetX_npRangeLength) _planetX_npPixels)
      for i (_planetX_npRangeLength - 1) {
        atPut ('_planetX_npIndex' ((_planetX_npRangeLength - i) + 1)) _planetX_npPixels (at ('_planetX_npIndex' (_planetX_npRangeLength - i)) _planetX_npPixels)
      }
      atPut ('_planetX_npIndex' 1) _planetX_npPixels last
    }
  } else {
    repeat (absoluteValue offset) {
      local 'first' (at ('_planetX_npIndex' 1) _planetX_npPixels)
      for i (_planetX_npRangeLength - 1) {
        atPut ('_planetX_npIndex' i) _planetX_npPixels (at ('_planetX_npIndex' (i + 1)) _planetX_npPixels)
      }
      atPut ('_planetX_npIndex' _planetX_npRangeLength) _planetX_npPixels first
    }
  }
  '_planetX_npUpdate'
}

to planetX_neopixelSetPixelColor pixel color {
  '_planetX_npEnsure'
  if (and (pixel >= 1) (pixel <= _planetX_npRangeLength)) {
    atPut ('_planetX_npIndex' pixel) _planetX_npPixels color
    '_planetX_npUpdate'
  }
}

to planetX_neopixelShift offset {
  '_planetX_npEnsure'
  if (offset == 0) {
    return
  }
  if (offset > 0) {
    repeat offset {
      for i (_planetX_npRangeLength - 1) {
        atPut ('_planetX_npIndex' ((_planetX_npRangeLength - i) + 1)) _planetX_npPixels (at ('_planetX_npIndex' (_planetX_npRangeLength - i)) _planetX_npPixels)
      }
      atPut ('_planetX_npIndex' 1) _planetX_npPixels 0
    }
  } else {
    repeat (absoluteValue offset) {
      for i (_planetX_npRangeLength - 1) {
        atPut ('_planetX_npIndex' i) _planetX_npPixels (at ('_planetX_npIndex' (i + 1)) _planetX_npPixels)
      }
      atPut ('_planetX_npIndex' _planetX_npRangeLength) _planetX_npPixels 0
    }
  }
  '_planetX_npUpdate'
}

to planetX_oledClear {
  '_planetX_oledEnsureLines'
  atPut 'all' _planetX_oledLines ''
  if (not ('_planetX_oledEnsure')) {
    return
  }
}

to planetX_oledShowNumber line n {
  planetX_oledShowText line ('[data:convertType]' n 'string')
}

to planetX_oledShowText line text {
  line = (maximum 1 (minimum line 8))
  '_planetX_oledEnsureLines'
  atPut line _planetX_oledLines text
  if (not ('_planetX_oledEnsure')) {
    return
  }
}

to planetX_tm1637Clear {
  '_planetX_tmEnsure'
  atPut 'all' _planetX_tmDigits 0
  '_planetX_tmRefresh'
}

to planetX_tm1637Create port {
  _planetX_tmClockPin = ('_planetX_jPortPin' port 'A')
  _planetX_tmDataPin = ('_planetX_jPortPin' port 'B')
  sayIt _planetX_tmClockPin _planetX_tmDataPin
  _planetX_tmBrightness = 7
  digitalWriteOp _planetX_tmClockPin false
  digitalWriteOp _planetX_tmDataPin false
  '_planetX_tmEnsure'
  atPut 'all' _planetX_tmDigits 0
  '_planetX_tmRefresh'
}

to planetX_tm1637ShowDP bit show {
  '_planetX_tmEnsure'
  if (not ('_planetX_tmValidDigitIndex' bit)) {
    return
  }
  local 'segments' (at bit _planetX_tmDigits)
  if show {
    segments = (segments | 128)
  } else {
    segments = (segments & 127)
  }
  atPut bit _planetX_tmDigits segments
  '_planetX_tmShowSegments' segments bit
}

to planetX_tm1637ShowNumber n {
  '_planetX_tmEnsure'
  atPut 'all' _planetX_tmDigits 0
  n = (maximum 0 (minimum n 9999))
  if (n == 0) {
    atPut 1 _planetX_tmDigits ('_planetX_tmSegmentsForNum' 0)
    '_planetX_tmRefresh'
    return
  }
  local 'thousands' (n / 1000)
  local 'hundreds' ((n / 100) % 10)
  local 'tens' ((n / 10) % 10)
  local 'ones' (n % 10)
  atPut 4 _planetX_tmDigits ('_planetX_tmSegmentsForNum' thousands)
  atPut 3 _planetX_tmDigits ('_planetX_tmSegmentsForNum' hundreds)
  atPut 2 _planetX_tmDigits ('_planetX_tmSegmentsForNum' tens)
  atPut 1 _planetX_tmDigits ('_planetX_tmSegmentsForNum' ones)
  '_planetX_tmRefresh'
}

