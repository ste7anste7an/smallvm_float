module Display Control
author 'Elecfreaks Team'
version 1 4
description 'Nixie tube
neopixel
OLED Display
dot-matrix display screen'
variables _gpio_buttonEdges _gpio_dsLastTemp _gpio_sr04_last _gpio_sr04_misses
variables _gpio_dht_temperature _gpio_dht_humidity _gpio_dhtData _gpio_dhtLastReadTime _gpio_dhtRawPulses
variables _gpio_tmClockPin _gpio_tmDataPin _gpio_tmBrightness _gpio_tmDigits
variables _gpio_npPixels _gpio_npPin _gpio_npHasWhite _gpio_npRangeStart _gpio_npRangeLength
variables _gpio_mp3Pin
variables _gpio_wifiConnected _gpio_wifiLastResponse _gpio_wifiTXPin _gpio_wifiRXPin _gpio_wifiBaudRate
variables _gpio_i2cReady _gpio_matrixReady _gpio_matrixBuf
variables _gpio_asrEvents

choices ioAdcPort 'J1' 'J2' 'J3' 'J4'
choices planetXNeoMode 'RGB(GRB order)' 'RGBW' 'RGB(RGB order)'
choices planetXNeoColor 'red' 'orange' 'yellow' 'green' 'blue' 'indigo' 'violet' 'purple' 'white' 'black'
choices planetXMatrixEmoji 'smile' 'crying face' 'neutral face' 'heart' 'check mark' 'cross'
variables _planetX_extI2CReady _planetX_oledReady _planetX_oledAddr _planetX_oledBusy _planetX_oledLines

  variables _planetX_i2cRequestBusy _planetX_i2cQueue

spec ' ' 'tm1637Create' 'numeric display set port _' 'menu.ioAdcPort' 'J1'
  spec ' ' 'planetX_tm1637ShowNumber' 'numeric display show _ (0-9999)' 'num' 1234
  spec ' ' 'planetX_tm1637ShowDP' 'numeric display digit _ (1-4) decimal point show _' 'num bool' 2 true
  spec ' ' 'planetX_tm1637Clear' 'clear numeric display'
  space
  space
  spec ' ' 'planetX_neopixelCreate' 'connect rainbow LED to _ : count _ mode _' 'menu.ioAdcPort num menu.planetXNeoMode' 'J1' 10 'RGB(GRB order)'
  spec ' ' 'planetX_neopixelAllSetColor' 'set rainbow LED color _' 'color'
  spec ' ' 'planetX_neopixelSetPixelColor' 'set rainbow LED pixel _ to _' 'num color' 1 16711680
  spec ' ' 'planetX_neopixelBrightness' 'rainbow LED brightness _' 'num' 64
  spec ' ' 'planetX_neopixelRainbowShow' 'rainbow LED show gradient color'
  spec ' ' 'planetX_neopixelShift' 'shift rainbow LED _' 'num' 1
  spec ' ' 'planetX_neopixelRotate' 'rotate rainbow LED _' 'num' 1
  spec ' ' 'planetX_neopixelClear' 'clear rainbow LED'
  spec 'r' 'planetX_neopixelRGB' 'generate RGB color _ _ _' 'num num num' 255 0 0
  spec 'r' 'planetX_neopixelHSL' 'generate HSV color _ _ _' 'num num num' 180 100 50
  spec 'r' 'planetX_neopixelColor' 'rainbow LED color _' 'menu.planetXNeoColor' 'red'
  spec ' ' 'planetX_neopixelRange' 'rainbow LED range start _ length _' 'num num' 1 5
  space
  spec ' ' 'showUserText' 'OLED line _ show text _' 'num str' 1 'Hello'
  spec ' ' 'showUserNumber' 'OLED line _ show number _' 'num num' 2 123456
  spec ' ' 'oledClear' 'clear OLED'
  space
  spec ' ' 'matrixDraw' 'matrix display coordinate X _ Y _' 'num num' 0 0
  spec ' ' 'matrixEmoji' '5x5 matrix display emoji _' 'menu.planetXMatrixEmoji' 'smile'
  spec ' ' 'matrixRefresh' 'refresh matrix display'
  spec ' ' 'matrixClear' 'clear matrix display'

to '_gpio_tmDelay' {
  waitMicros 10
}

to '_gpio_tmSegmentsForNum' n {
  if (or (n < 0) (n > 15)) {return 0}
  // Keep this expression board-compatible. The ESP32 MicroBlocks compiler
  // supports hexToInt and copyFromTo, but not GP's variadic list constructor.
  local 'i' ((3 * n) + 1)
  return (hexToInt ('[data:copyFromTo]' '3f,06,5b,4f,66,6d,7d,07,7f,6f,77,7c,39,5e,79,71' i (i + 1)))
}

to '_gpio_tmStart' {
  digitalWriteOp _gpio_tmClockPin true
  digitalWriteOp _gpio_tmDataPin true
  digitalWriteOp _gpio_tmDataPin false
  digitalWriteOp _gpio_tmClockPin false
}

to '_gpio_tmStop' {
  digitalWriteOp _gpio_tmClockPin false
  digitalWriteOp _gpio_tmDataPin false
  digitalWriteOp _gpio_tmClockPin true
  digitalWriteOp _gpio_tmDataPin true
}

to '_gpio_tmWriteByte' byte {
  repeat 8 {
    digitalWriteOp _gpio_tmClockPin false
    if ((byte & 1) == 1) {
      digitalWriteOp _gpio_tmDataPin true
    } else {
      digitalWriteOp _gpio_tmDataPin false
    }
    '_gpio_tmDelay'
    digitalWriteOp _gpio_tmClockPin true
    byte = (byte >> 1)
    '_gpio_tmDelay'
  }
  digitalWriteOp _gpio_tmClockPin false
  digitalWriteOp _gpio_tmDataPin false
  digitalWriteOp _gpio_tmClockPin true
}

to '_gpio_tmShowSegments' value index {
  '_gpio_tmStart'
  '_gpio_tmWriteByte' (hexToInt '44')
  '_gpio_tmStop'
  '_gpio_tmStart'
  '_gpio_tmWriteByte' ((hexToInt 'C0') | (4 - index))
  '_gpio_tmWriteByte' value
  '_gpio_tmStop'
  '_gpio_tmStart'
  '_gpio_tmWriteByte' ((hexToInt '88') + _gpio_tmBrightness)
  '_gpio_tmStop'
}

to '_gpio_tmEnsure' {
  if (_gpio_tmDigits == 0) {
    _gpio_tmDigits = (newList 4)
    atPut 'all' _gpio_tmDigits 0
  }
}

to '_gpio_tmRefresh' {
  '_gpio_tmEnsure'
  for i 4 {
    '_gpio_tmShowSegments' (at i _gpio_tmDigits) i
  }
}

to tm1637Create port {
  if (port == 'J2') {
    _gpio_tmClockPin = 6
    _gpio_tmDataPin = 7
  } (port == 'J3') {
    _gpio_tmClockPin = 15
    _gpio_tmDataPin = 16
  } (port == 'J4') {
    _gpio_tmClockPin = 17
    _gpio_tmDataPin = 18
  } else {
    _gpio_tmClockPin = 4
    _gpio_tmDataPin = 5
  }
  _gpio_tmBrightness = 7
  digitalWriteOp _gpio_tmClockPin false
  digitalWriteOp _gpio_tmDataPin false
  '_gpio_tmEnsure'
  atPut 'all' _gpio_tmDigits 0
  '_gpio_tmRefresh'
}

// Hidden compatibility entry point for projects created before the palette
// was simplified to one whole-number display block.
to planetX_tm1637ShowBit bit num {
  '_gpio_tmEnsure'
  if (not ('_gpio_tmValidDigitIndex' bit)) {return}
  atPut bit _gpio_tmDigits ('_gpio_tmSegmentsForNum' (num % 16))
  '_gpio_tmShowSegments' (at bit _gpio_tmDigits) bit
}

to planetX_tm1637ShowNumber n {
  '_gpio_tmEnsure'
  atPut 'all' _gpio_tmDigits 0
  n = (maximum 0 (minimum n 9999))
  if (n == 0) {
    atPut 1 _gpio_tmDigits ('_gpio_tmSegmentsForNum' 0)
    '_gpio_tmRefresh'
    return
  }
  // The official PlanetX implementation extracts each decimal position.
  // '/' is integer division in the board VM, so no unsupported truncate
  // operation is needed here.
  local 'thousands' (n / 1000)
  local 'hundreds' ((n / 100) % 10)
  local 'tens' ((n / 10) % 10)
  local 'ones' (n % 10)
  atPut 4 _gpio_tmDigits ('_gpio_tmSegmentsForNum' thousands)
  atPut 3 _gpio_tmDigits ('_gpio_tmSegmentsForNum' hundreds)
  atPut 2 _gpio_tmDigits ('_gpio_tmSegmentsForNum' tens)
  atPut 1 _gpio_tmDigits ('_gpio_tmSegmentsForNum' ones)
  '_gpio_tmRefresh'
}

// Control the decimal point on one digit.
to planetX_tm1637ShowDP bit show {
  '_gpio_tmEnsure'
  if (not ('_gpio_tmValidDigitIndex' bit)) {return}
  local 'segments' (at bit _gpio_tmDigits)
  if show {
    segments = (segments | 128)
  } else {
    segments = (segments & 127)
  }
  atPut bit _gpio_tmDigits segments
  '_gpio_tmShowSegments' segments bit
}

// TM1637 has exactly four digit positions. Ignore invalid or fractional
// positions instead of silently redirecting them to another digit.
to '_gpio_tmValidDigitIndex' bit {
  return (and (and (bit >= 1) (bit <= 4)) ((bit % 1) == 0))
}

to planetX_tm1637Clear {
  '_gpio_tmEnsure'
  atPut 'all' _gpio_tmDigits 0
  '_gpio_tmRefresh'
}

to '_gpio_npUpdate' {
  '[display:neoPixelSetPin]' _gpio_npPin _gpio_npHasWhite
  '[display:neoPixelSend]' _gpio_npPixels
  waitMicros 300
}

to '_gpio_colorFromRGB' r g b {
  r = (maximum 0 (minimum r 255))
  g = (maximum 0 (minimum g 255))
  b = (maximum 0 (minimum b 255))
  return (((r << 16) | (g << 8)) | b)
}

to '_gpio_npEnsure' {
  if (_gpio_npPixels == 0) {
    planetX_neopixelCreate 'J1' 10 'RGB(GRB)'
  }
  if (_gpio_npRangeStart == 0) {
    _gpio_npRangeStart = 1
    _gpio_npRangeLength = (size _gpio_npPixels)
  }
}

to '_gpio_npIndex' i {
  '_gpio_npEnsure'
  return ((_gpio_npRangeStart + i) - 1)
}

to planetX_neopixelCreate port optionalCount optionalMode {
  local 'count' (argOrDefault 2 10)
  local 'mode' (argOrDefault 3 'RGB(GRB order)')
  count = (maximum 1 count)
  local 'hasWhite' (mode == 'RGBW')
  '[display:neoPixelSetRGB]' (('[data:find]' 'RGB(RGB' mode) == 1)
  if (port == 'J2') {
    _gpio_npPin = 7
  } (port == 'J3') {
    _gpio_npPin = 16
  } (port == 'J4') {
    _gpio_npPin = 18
  } else {
    _gpio_npPin = 5
  }
  _gpio_npHasWhite = hasWhite
  if (or (_gpio_npPixels == 0) (count != (size _gpio_npPixels))) {
    _gpio_npPixels = (newList count)
  }
  atPut 'all' _gpio_npPixels 0
  '[display:neoPixelSetPin]' _gpio_npPin _gpio_npHasWhite
  _gpio_npRangeStart = 1
  _gpio_npRangeLength = count
}
to planetX_neopixelAllSetColor color {
  '_gpio_npEnsure'
  for i _gpio_npRangeLength {
    atPut ('_gpio_npIndex' i) _gpio_npPixels color
  }
  '_gpio_npUpdate'
}

to planetX_neopixelSetPixelColor pixel color {
  '_gpio_npEnsure'
  if (and (pixel >= 1) (pixel <= _gpio_npRangeLength)) {
    atPut ('_gpio_npIndex' pixel) _gpio_npPixels color
    '_gpio_npUpdate'
  }
}

to planetX_neopixelShow {
  '_gpio_npEnsure'
  '_gpio_npUpdate'
}

to planetX_neopixelClear {
  '_gpio_npEnsure'
  for i _gpio_npRangeLength {
    atPut ('_gpio_npIndex' i) _gpio_npPixels 0
  }
  '_gpio_npUpdate'
}

to planetX_neopixelBrightness brightness {
  brightness = (maximum 10 (minimum brightness 255))
  '[display:neoPixelSetMaxBrightness]' brightness
  '_gpio_npUpdate'
}

to planetX_neopixelRGB r g b {
  r = (maximum 0 (minimum r 255))
  g = (maximum 0 (minimum g 255))
  b = (maximum 0 (minimum b 255))
  return (((r << 16) | (g << 8)) | b)
}
to planetX_neopixelColor c {
  if (or (c == 'orange') (c == '橙色')) {
    return ('_gpio_colorFromRGB' 255 128 0)
  } (or (c == 'yellow') (c == '黄色')) {
    return ('_gpio_colorFromRGB' 255 255 0)
  } (or (c == 'green') (c == '绿色')) {
    return ('_gpio_colorFromRGB' 0 255 0)
  } (or (c == 'blue') (c == '蓝色')) {
    return ('_gpio_colorFromRGB' 0 0 255)
  } (or (c == 'indigo') (c == '靛色')) {
    return ('_gpio_colorFromRGB' 75 0 130)
  } (or (c == 'violet') (c == '紫罗兰')) {
    return ('_gpio_colorFromRGB' 143 0 255)
  } (or (c == 'purple') (c == '紫色')) {
    return ('_gpio_colorFromRGB' 160 32 240)
  } (or (c == 'white') (c == '白色')) {
    return ('_gpio_colorFromRGB' 255 255 255)
  } (or (c == 'black') (c == '黑色')) {
    return 0
  }
  return ('_gpio_colorFromRGB' 255 0 0)
}

to planetX_neopixelHSL h s v {
  return ('[misc:hsvColor]' h s v)
}

to planetX_neopixelRange start length {
  '_gpio_npEnsure'
  start = (maximum 1 (minimum start (size _gpio_npPixels)))
  length = (maximum 1 (minimum length (((size _gpio_npPixels) - start) + 1)))
  _gpio_npRangeStart = start
  _gpio_npRangeLength = length
}

to planetX_neopixelShift offset {
  '_gpio_npEnsure'
  if (offset == 0) {return}
  if (offset > 0) {
    repeat offset {
      for i (_gpio_npRangeLength - 1) {
        atPut ('_gpio_npIndex' ((_gpio_npRangeLength - i) + 1)) _gpio_npPixels (at ('_gpio_npIndex' (_gpio_npRangeLength - i)) _gpio_npPixels)
      }
      atPut ('_gpio_npIndex' 1) _gpio_npPixels 0
    }
  } else {
    repeat (absoluteValue offset) {
      for i (_gpio_npRangeLength - 1) {
        atPut ('_gpio_npIndex' i) _gpio_npPixels (at ('_gpio_npIndex' (i + 1)) _gpio_npPixels)
      }
      atPut ('_gpio_npIndex' _gpio_npRangeLength) _gpio_npPixels 0
    }
  }
  '_gpio_npUpdate'
}

to planetX_neopixelRotate offset {
  '_gpio_npEnsure'
  if (offset == 0) {return}
  if (offset > 0) {
    repeat offset {
      local 'last' (at ('_gpio_npIndex' _gpio_npRangeLength) _gpio_npPixels)
      for i (_gpio_npRangeLength - 1) {
        atPut ('_gpio_npIndex' ((_gpio_npRangeLength - i) + 1)) _gpio_npPixels (at ('_gpio_npIndex' (_gpio_npRangeLength - i)) _gpio_npPixels)
      }
      atPut ('_gpio_npIndex' 1) _gpio_npPixels last
    }
  } else {
    repeat (absoluteValue offset) {
      local 'first' (at ('_gpio_npIndex' 1) _gpio_npPixels)
      for i (_gpio_npRangeLength - 1) {
        atPut ('_gpio_npIndex' i) _gpio_npPixels (at ('_gpio_npIndex' (i + 1)) _gpio_npPixels)
      }
      atPut ('_gpio_npIndex' _gpio_npRangeLength) _gpio_npPixels first
    }
  }
  '_gpio_npUpdate'
}

to planetX_neopixelRainbow optionalStartHue optionalEndHue {
  '_gpio_npEnsure'
  local 'startHue' (argOrDefault 1 1)
  local 'endHue' (argOrDefault 2 360)
  if (_gpio_npRangeLength <= 1) {
    atPut ('_gpio_npIndex' 1) _gpio_npPixels ('[misc:hsvColor]' startHue 100 100)
    '_gpio_npUpdate'
    return
  }
  local 'span' (endHue - startHue)
  for i _gpio_npRangeLength {
    atPut ('_gpio_npIndex' i) _gpio_npPixels ('[misc:hsvColor]' (startHue + ((span * (i - 1)) / (_gpio_npRangeLength - 1))) 100 100)
  }
  '_gpio_npUpdate'
}

// Product-facing no-argument selector; the old selector remains available to
// saved projects that specified a hue range.
to planetX_neopixelRainbowShow {
  planetX_neopixelRainbow 1 360
}

to '_gpio_matrixCmd' value {
  return ('_planetX_i2cPortWrite' 112 ('[data:makeList]' value))
}

to '_gpio_matrixEnsure' {
  if (not _gpio_i2cReady) {
    _gpio_i2cReady = ('_planetX_extI2CInit')
  }
  if (not _gpio_i2cReady) {
    return false
  }
  if (not _gpio_matrixReady) {
    _gpio_matrixBuf = ('[data:newByteArray]' 17 0)
    atPut 1 _gpio_matrixBuf 0
    if (not ('_gpio_matrixCmd' 33)) {return false}
    if (not ('_gpio_matrixCmd' 129)) {return false}
    if (not ('_gpio_matrixCmd' 239)) {return false}
    _gpio_matrixReady = true
  }
  return true
}
to '_gpio_matrixShow' {
  if (not ('_gpio_matrixEnsure')) {return false}
  atPut 1 _gpio_matrixBuf 0
  return ('_planetX_i2cPortWrite' 112 _gpio_matrixBuf)
}

to '_gpio_matrixSetRow' y bits {
  if (not ('_gpio_matrixEnsure')) {return false}
  atPut ((2 * y) + 2) _gpio_matrixBuf (bits & 255)
  atPut ((2 * y) + 3) _gpio_matrixBuf ((bits >> 8) & 255)
  return true
}

to '_gpio_matrixSetPoint' x y {
  if (not ('_gpio_matrixEnsure')) {return false}
  x = (maximum 0 (minimum x 15))
  y = (maximum 0 (minimum y 7))
  local 'byteIndex' (((y * 2) + 2) + (ifExpression (x < 8) 0 1))
  atPut byteIndex _gpio_matrixBuf ((at byteIndex _gpio_matrixBuf) | (1 << (x % 8)))
  return true
}

to matrixRefresh {
  '_gpio_matrixShow'
}

to matrixClear {
  if (not ('_gpio_matrixEnsure')) {return}
  for i 16 {
    atPut (i + 1) _gpio_matrixBuf 0
  }
  '_gpio_matrixShow'
}

to matrixDraw x y {
  '_gpio_matrixSetPoint' x y
  '_gpio_matrixShow'
}

to '_gpio_matrixShow5x5' row1 row2 row3 row4 row5 {
  if (not ('_gpio_matrixEnsure')) {return}
  for i 8 {
    '_gpio_matrixSetRow' (i - 1) 0
  }
  '_gpio_matrixSetRow' 1 (row1 << 5)
  '_gpio_matrixSetRow' 2 (row2 << 5)
  '_gpio_matrixSetRow' 3 (row3 << 5)
  '_gpio_matrixSetRow' 4 (row4 << 5)
  '_gpio_matrixSetRow' 5 (row5 << 5)
  '_gpio_matrixShow'
}

to matrixEmoji emoji {
  if (or (emoji == 'crying face') (or (emoji == '哭脸') (or (emoji == 'sad') (emoji == '难过')))) {
    '_gpio_matrixShow5x5' 10 27 0 14 17
  } (or (emoji == 'neutral face') (or (emoji == '正常脸') (emoji == '平脸'))) {
    '_gpio_matrixShow5x5' 10 0 0 31 0
  } (or (emoji == 'heart') (or (emoji == '爱心') (emoji == '心'))) {
    '_gpio_matrixShow5x5' 10 31 31 14 4
  } (or (emoji == 'check mark') (or (emoji == '对钩') (emoji == '勾选'))) {
    '_gpio_matrixShow5x5' 1 2 20 8 0
  } (or (emoji == 'cross') (or (emoji == 'angry') (or (emoji == '交叉') (or (emoji == '叉') (emoji == '生气'))))) {
    '_gpio_matrixShow5x5' 17 10 4 10 17
  } else {
    '_gpio_matrixShow5x5' 10 0 17 14 0
  }
}

to '_planetX_extI2CInit' {
  // sensors primitives initialize Wire on their first call.
  _planetX_extI2CReady = true
  return true
}

to '_planetX_i2cPortWrite' addr bytes {
  if (not ('_planetX_i2cAcquire')) {return false}
  '[sensors:i2cSetClockSpeed]' 200000
  local 'present' ('[sensors:i2cExists]' addr)
  if present {
    if (and ((size bytes) > 32) ((at 1 bytes) == 64)) {
      '_planetX_oledWriteDataUnlocked' addr bytes
    } else {
      '[sensors:i2cWrite]' addr bytes
    }
  }
  '_planetX_i2cRelease'
  return present
}

to '_planetX_i2cPortExists' addr {
  if (not ('_planetX_i2cAcquire')) {return false}
  '[sensors:i2cSetClockSpeed]' 200000
  local 'present' ('[sensors:i2cExists]' addr)
  '_planetX_i2cRelease'
  return present
}

to '_planetX_oledProbeAddr' addr {
  _planetX_oledAddr = addr
  return ('_planetX_i2cPortWrite' _planetX_oledAddr ('[data:makeList]' 128 174))
}

to '_planetX_oledCmd' value {
  return ('_planetX_i2cPortWrite' _planetX_oledAddr ('[data:makeList]' 128 value))
}

to '_planetX_oledData' value {
  return ('_planetX_i2cPortWrite' _planetX_oledAddr ('[data:makeList]' 64 value))
}

to '_planetX_oledWakeCore' {
  if (not ('_planetX_oledCmd' 64)) {return false}
  if (not ('_planetX_oledCmd' 164)) {return false}
  if (not ('_planetX_oledCmd' 166)) {return false}
  if (not ('_planetX_oledCmd' 32)) {return false}
  if (not ('_planetX_oledCmd' 2)) {return false}
  if (not ('_planetX_oledCmd' 161)) {return false}
  if (not ('_planetX_oledCmd' 200)) {return false}
  if (not ('_planetX_oledCmd' 141)) {return false}
  if (not ('_planetX_oledCmd' 20)) {return false}
  waitMillis 2
  return ('_planetX_oledCmd' 175)
}

to '_planetX_oledInitCore' {
  if (not ('_planetX_oledCmd' 174)) {return false}
  if (not ('_planetX_oledCmd' 64)) {return false}
  if (not ('_planetX_oledCmd' 164)) {return false}
  if (not ('_planetX_oledCmd' 166)) {return false}
  if (not ('_planetX_oledCmd' 32)) {return false}
  if (not ('_planetX_oledCmd' 2)) {return false}
  if (not ('_planetX_oledCmd' 161)) {return false}
  if (not ('_planetX_oledCmd' 200)) {return false}
  if (not ('_planetX_oledCmd' 141)) {return false}
  if (not ('_planetX_oledCmd' 20)) {return false}
  waitMillis 10
  return ('_planetX_oledCmd' 175)
}

to '_planetX_oledEnsureLines' {
  if (_planetX_oledLines == 0) {
    _planetX_oledLines = (newList 8)
    atPut 'all' _planetX_oledLines ''
  }
}

to '_planetX_oledPutCharToBuf' ch buf idx {
  local 'columns' ('[misc:shapeforChar]' ch)
  atPut idx buf 0
  idx += 1
  if (columns != 0) {
    for i 5 {
      atPut idx buf (at i columns)
      idx += 1
    }
  } else {
    repeat 5 {
      atPut idx buf 0
      idx += 1
    }
  }
  atPut idx buf 0
  idx += 1
  atPut idx buf 0
  return (idx + 1)
}

to '_planetX_oledLineBuffer' text {
  local 'buf' ('[data:newByteArray]' 129 0)
  atPut 1 buf 64
  local 'idx' 2
  local 'col' 0
  for ch text {
    if (col < 16) {
      idx = ('_planetX_oledPutCharToBuf' ch buf idx)
      col += 1
    }
  }
  return buf
}

to '_planetX_oledWriteLineCore' row text {
  '_planetX_oledSetText' row 0
  return ('_planetX_i2cPortWrite' _planetX_oledAddr ('_planetX_oledLineBuffer' text))
}

to '_planetX_oledRenderAllLinesCore' {
  '_planetX_oledEnsureLines'
  for row 8 {
    if (not ('_planetX_oledWriteLineCore' (row - 1) (at row _planetX_oledLines))) {
      return false
    }
  }
  return true
}

to '_planetX_oledSetText' row column {
  row = (maximum 0 (minimum row 7))
  column = (maximum 0 (minimum column 15))
  local 'x' (8 * column)
  '_planetX_oledCmd' (176 + row)
  '_planetX_oledCmd' (x & 15)
  '_planetX_oledCmd' (16 + ((x >> 4) & 15))
}

to '_planetX_oledPutChar' ch {
  local 'columns' ('[misc:shapeforChar]' ch)
  '_planetX_oledData' 0
  if (columns != 0) {
    for i 5 {
      '_planetX_oledData' (at i columns)
    }
  } else {
    repeat 5 {
      '_planetX_oledData' 0
    }
  }
  '_planetX_oledData' 0
  '_planetX_oledData' 0
}

to '_planetX_oledLock' {
  repeatUntil (not _planetX_oledBusy) {
    waitMillis 1
  }
  _planetX_oledBusy = true
}

to '_planetX_oledUnlock' {
  _planetX_oledBusy = false
}

to '_planetX_oledClearCore' {
  for j 8 {
    '_planetX_oledSetText' (j - 1) 0
    repeat 16 {
      '_planetX_oledPutChar' ' '
    }
  }
  '_planetX_oledSetText' 0 0
}

to '_planetX_oledEnsure' {
  if (not ('_planetX_extI2CInit')) {
    return false
  }
  '_planetX_oledLock'
  if _planetX_oledReady {
    if ('_planetX_oledWakeCore') {
      if (not ('_planetX_oledRenderAllLinesCore')) {
        _planetX_oledReady = false
        '_planetX_oledUnlock'
        return false
      }
      '_planetX_oledUnlock'
      return true
    }
    _planetX_oledReady = false
  }
  if (not ('_planetX_oledProbeAddr' 60)) {
    if (not ('_planetX_oledProbeAddr' 61)) {
      '_planetX_oledUnlock'
      return false
    }
  }
  if (not ('_planetX_oledInitCore')) {
    '_planetX_oledUnlock'
    return false
  }
  _planetX_oledReady = true
  if (not ('_planetX_oledRenderAllLinesCore')) {
    _planetX_oledReady = false
    '_planetX_oledUnlock'
    return false
  }
  '_planetX_oledUnlock'
  return true
}

to showUserText line text {
  line = (maximum 1 (minimum line 8))
  '_planetX_oledEnsureLines'
  atPut line _planetX_oledLines text
  if (not ('_planetX_oledEnsure')) {return}
}

to showUserNumber line n {
  showUserText line ('[data:convertType]' n 'string')
}

to oledClear {
  '_planetX_oledEnsureLines'
  atPut 'all' _planetX_oledLines ''
  if (not ('_planetX_oledEnsure')) {return}
}

to '_planetX_i2cAcquire' {
  if (_planetX_i2cQueue == 0) {_planetX_i2cQueue = ('[data:makeList]')}
  // Distinct objects identify requests without a wrapping ticket counter.
  local 'request' ('[data:newByteArray]' 1 0)
  '[data:addLast]' request _planetX_i2cQueue
  if (('[data:find]' request _planetX_i2cQueue) < 1) {return false}
  local 'start' (millisOp)
  repeatUntil (and (not _planetX_i2cRequestBusy) ((at 1 _planetX_i2cQueue) == request)) {
    if ((millisSince start) >= 500) {
      local 'index' ('[data:find]' request _planetX_i2cQueue)
      if (index > 0) {'[data:delete]' index _planetX_i2cQueue}
      return false
    }
    waitMillis 1
  }
  _planetX_i2cRequestBusy = true
  return true
}

to '_planetX_i2cRelease' {
  if (not _planetX_i2cRequestBusy) {return}
  '[data:delete]' 1 _planetX_i2cQueue
  _planetX_i2cRequestBusy = false
}

to '_planetX_oledWriteDataUnlocked' addr bytes {
  // Each OLED data packet needs its own 0x40 control byte.
  local 'offset' 2
  repeatUntil (offset > (size bytes)) {
    local 'count' (minimum 31 (((size bytes) - offset) + 1))
    local 'packet' ('[data:newByteArray]' (count + 1) 0)
    atPut 1 packet 64
    for i count {atPut (i + 1) packet (at ((offset + i) - 1) bytes)}
    '[sensors:i2cWrite]' addr packet
    offset += count
  }
}
