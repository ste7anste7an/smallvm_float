module 'Planet X Execute' Control
author 'Elecfreaks Team'
version 2 4
depends '_Planet X Support' 
choices planetXMP3Action play stop 'next track' 'previous track' pause 
description 'laser
WIKI:
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05013

fan
WIKI (motorFan):
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05014

LED
WIKI:
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05009
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05010
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05011
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05012

MP3
WIKI:
https://wiki.elecfreaks.com/microbit/planetx-series/sensors/Plant_X_EF05038'
variables _planetX_mp3Pin 

  spec ' ' 'planetX_laserSwitch' 'laser module _ turn _' 'menu.planetXPort bool' 'J1' true
  space
  spec ' ' 'planetX_motorFanSwitch' 'fan _ turn _' 'menu.planetXPort bool' 'J1' false
  space
  spec ' ' 'planetX_ledSwitch' 'LED _ turn _' 'menu.planetXPort bool' 'J1' true
  space
  spec ' ' 'planetX_mp3SetPort' 'MP3 set port _' 'menu.planetXPort' 'J1'
  spec ' ' 'planetX_mp3SetVolume' 'MP3 set volume _ (0-25)' 'num' 25
  spec ' ' 'planetX_mp3PlayFolder' 'MP3 play folder _ file _ : repeat _' 'num num bool' 1 1 false
  spec ' ' 'planetX_mp3PlayTrack' 'MP3 play track _ : repeat _' 'num bool' 1 false
  spec ' ' 'planetX_mp3LoopFolder' 'MP3 loop folder _' 'num' 1
  spec ' ' 'planetX_mp3Execute' 'MP3 execute _' 'menu.planetXMP3Action' 'play'
  spec ' ' '_planetX_mp3Ensure' '_planetX_mp3Ensure'
  spec ' ' '_planetX_mp3OpenPort' '_planetX_mp3OpenPort _' 'auto' 'J1'
  spec ' ' '_planetX_mp3Send' '_planetX_mp3Send _ _ _' 'auto auto auto' 0 0 0
  spec ' ' '_planetX_ledBrightness' '_planetX_ledBrightness _ _ _' 'auto auto auto' 0 0 0
  spec ' ' '_planetX_motorFan' '_planetX_motorFan _ _ _' 'auto auto auto' 0 0 0

to '_planetX_ledBrightness' port on optionalBrightness {
  local 'brightness' (argOrDefault 3 100)
  brightness = (maximum 0 (minimum brightness 100))
  local 'pin' ('_planetX_jPortPin' port 'A')
  if (and on (brightness > 0)) {
    analogWriteOp pin ((1023 * brightness) / 100)
  } else {
    analogWriteOp pin 0
    digitalWriteOp pin false
  }
}

to '_planetX_motorFan' port on optionalSpeed {
  local 'speed' (argOrDefault 3 100)
  speed = (maximum 0 (minimum speed 100))
  local 'pin' ('_planetX_jPortPin' port 'A')
  if (and on (speed > 0)) {
    analogWriteOp pin ((1023 * speed) / 100)
  } else {
    analogWriteOp pin 0
    digitalWriteOp pin false
  }
}

to '_planetX_mp3Ensure' {
  if (_planetX_mp3Pin == 0) {
    '_planetX_mp3OpenPort' 'J1'
  }
}

to '_planetX_mp3OpenPort' port {
  local 'txPin' ('_planetX_jPortPin' port 'B')
  local 'board' (boardType)
  if (or (board == 'micro:bit') (board == 'micro:bit v2')) {
    comment 'MP3 only needs output. Software serial is verified on micro:bit V2.'
    if (board == 'micro:bit v2') {
      comment 'Release pins if a previous project opened the hardware UART.'
      '[serial:close]'
    }
    digitalWriteOp txPin true
  } else {
    local 'rxPin' ('_planetX_jPortPin' port 'A')
    '[serial:open]' 9600 rxPin txPin
  }
  _planetX_mp3Pin = txPin
  waitMillis 50
}

to '_planetX_mp3Send' cmd arg1 arg2 {
  '_planetX_mp3Ensure'
  arg1 = (maximum 0 (minimum arg1 255))
  arg2 = (maximum 0 (minimum arg2 255))
  local 'msg' ('[data:makeList]' (hexToInt '7E') (hexToInt 'FF') 6 cmd 0 arg1 arg2 0 0 (hexToInt 'EF'))
  local 'sum' 0
  for i 6 {
    sum += (at (i + 1) msg)
  }
  sum = (65536 - sum)
  atPut 8 msg ((sum >> 8) & 255)
  atPut 9 msg (sum & 255)
  local 'board' (boardType)
  if (or (board == 'micro:bit') (board == 'micro:bit v2')) {
    for byte msg {
      '[io:softWriteByte]' byte _planetX_mp3Pin 9600
    }
  } else {
    comment 'A byte array is sent in one transfer. Lists are sent one byte at a time.'
    '[serial:write]' ('[data:asByteArray]' msg)
  }
  waitMillis 100
}

to planetX_laserSwitch port on {
  local 'pin' ('_planetX_jPortPin' port 'B')
  digitalWriteOp pin on
}

to planetX_ledSwitch port on {
  '_planetX_ledBrightness' port on 100
}

to planetX_motorFanSwitch port on {
  '_planetX_motorFan' port on 100
}

to planetX_mp3Execute action {
  local 'cmd' (hexToInt '0D')
  if (or (action == 'stop') (action == '停止')) {
    cmd = (hexToInt '16')
  } (or (or (action == 'next track') (action == '切换音乐')) (action == '下一首')) {
    cmd = (hexToInt '01')
  } (or (action == 'previous track') (action == '上一首')) {
    cmd = (hexToInt '02')
  } (or (action == 'pause') (action == '暂停')) {
    cmd = (hexToInt '0E')
  }
  '_planetX_mp3Send' cmd 0 0
}

to planetX_mp3LoopFolder folderNum {
  folderNum = (maximum 1 (minimum folderNum 99))
  '_planetX_mp3Send' (hexToInt '17') 0 folderNum
}

to planetX_mp3PlayFolder folderNum fileNum repeat {
  folderNum = (maximum 1 (minimum folderNum 99))
  fileNum = (maximum 1 (minimum fileNum 255))
  '_planetX_mp3Send' (hexToInt '0F') folderNum fileNum
  if repeat {
    '_planetX_mp3Send' (hexToInt '19') 0 0
  }
}

to planetX_mp3PlayTrack tracking repeat {
  tracking = (maximum 1 (minimum tracking 255))
  '_planetX_mp3Send' (hexToInt '03') 0 tracking
  '_planetX_mp3Send' (hexToInt '0D') 0 0
  if repeat {
    '_planetX_mp3Send' (hexToInt '19') 0 0
  }
}

to planetX_mp3SetPort port {
  '_planetX_mp3OpenPort' port
  planetX_mp3SetVolume 25
}

to planetX_mp3SetVolume volume {
  volume = (maximum 0 (minimum volume 25))
  '_planetX_mp3Send' (hexToInt '06') 0 volume
}

