module Wireless Control
author 'Elecfreaks Team'
version 1 6
tags wifi smartiot network http joystick i2c
description 'ESP8266 WiFi
SmartIoT
I2C rocker'
variables _gpio_wifiConnected _gpio_wifiLastResponse
variables _smartiot_connected _smartiot_sendMsg _smartiot_lastSendTime _smartiot_switchListenFlag _smartiot_switchStatus _smartiot_switchKnown _smartiot_requestBusy
variables _smartiot_switchOnEvent _smartiot_switchOffEvent _smartiot_host _smartiot_port _smartiot_token _smartiot_topic _smartiot_lastResponse

variables _planetX_i2cRequestBusy _planetX_i2cQueue

choices ioAdcPort 'J1' 'J2' 'J3' 'J4'
choices attention '⬆' '⬇' '⬅' '➡' '▷' '☐' '𐤏' '⨉' 'L1' 'R1' 'L2' 'R2' 'SELECT' 'START' 'L3' 'R3'
choices planetXJoystickAxis 'RX' 'RY' 'LX' 'LY'
choices smartIotSwitchMenu 'on' 'off'

  spec ' ' 'initWIFI' 'WiFi module set port _ baud rate _' 'menu.ioAdcPort num' 'J1' 115200
  spec ' ' 'connectWifi' 'WiFi connect SSID _ password _' 'str str' 'your_ssid' 'your_password'
  spec ' ' 'wifiSendAT' 'WiFi send AT _ wait _ ms' 'str num' 'AT' 500
  spec 'r' 'wifiRead' 'WiFi read response'
  spec 'r' 'wifiConnected' 'wifi connected'
  space
  space
  spec ' ' 'planetX_connectSmartiot' 'Connect SmartIoT with userToken _ topic _' 'str str' 'your User Token' '1'
  spec ' ' 'planetX_setSmartIotUploadData' 'set data to send SmartIoT Data 1 _ : Data 2 _ : Data 3 _ : Data 4 _ : Data 5 _ : Data 6 _ : Data 7 _ : Data 8 _' 'auto auto auto auto auto auto auto auto' 0 0 0 0 0 0 0 0
  spec ' ' 'planetX_uploadSmartIotData' 'Upload data to SmartIoT'
  spec 'r' 'planetX_smartiotConnected' 'smartiot connected'
  spec 'h' 'planetX_iotSwitchEvent' 'when SmartIoT switch is _' 'menu.smartIotSwitchMenu' 'on'
  spec 'r' 'planetX_smartIotSwitchState' 'SmartIoT switch is _' 'menu.smartIotSwitchMenu' 'on'
  space
  space
  spec 'r' 'getAttentionVal' 'joystick button _ is pressed' 'menu.attention' '⬆'
  spec 'r' 'planetX_joystickAnalog' 'joystick _ analog value' 'menu.planetXJoystickAxis' 'LX'

to '_smartiotEnsureDefaults' {
  if (_smartiot_host == 0) {_smartiot_host = 'http://www.smartiot.space'}
  if (_smartiot_port == 0) {_smartiot_port = 8080}
  if (_smartiot_token == 0) {_smartiot_token = ''}
  if (_smartiot_topic == 0) {_smartiot_topic = ''}
  if (_smartiot_sendMsg == 0) {_smartiot_sendMsg = ''}
  if (_smartiot_lastResponse == 0) {_smartiot_lastResponse = ''}
}

to '_planetX_attentionCode' button {
  if (button == '⬆') {return 5}
  if (button == '⬇') {return 7}
  if (button == '⬅') {return 8}
  if (button == '➡') {return 6}
  if (button == '▷') {return 13}
  if (button == '☐') {return 16}
  if (button == '𐤏') {return 14}
  if (button == '⨉') {return 15}
  if (button == 'L1') {return 11}
  if (button == 'R1') {return 12}
  if (button == 'L2') {return 9}
  if (button == 'R2') {return 10}
  if (button == 'SELECT') {return 1}
  if (button == 'START') {return 4}
  if (button == 'L3') {return 2}
  if (button == 'R3') {return 3}
  return 0
}

to '_planetX_attentionReadByte' {
  local 'response' ('[data:newByteArray]' 1 0)
  if (('[sensors:i2cRead]' 8 response) != 1) {return -1}
  return (at 1 response)
}

to getAttentionVal button {
  local 'code' ('_planetX_attentionCode' button)
  if (code == 0) {return false}
  return (('_planetX_attentionRequest' code) == 1)
}

to '_planetX_joystickAnalogCode' axis {
  if (axis == 'RX') {return 25}
  if (axis == 'RY') {return 26}
  if (axis == 'LY') {return 28}
  return 27
}

to planetX_joystickAnalog axis {
  local 'value' ('_planetX_attentionRequest' ('_planetX_joystickAnalogCode' axis))
  if (value < 0) {return 0}
  if (or (axis == 'RY') (axis == 'LY')) {
    if (value != 0) {value += 1}
  } else {
    if (and (value != 128) (value != 0)) {value += 1}
  }
  return (value * 4)
}

to '_smartiotATCommand' path {
  '_smartiotEnsureDefaults'
  return ('[data:join]' 'AT+HTTPCLIENT=2,0,"' _smartiot_host ':' _smartiot_port path '",,,1')
}

to '_smartiotATRequest' command responseKey timeoutMSecs {
  '_gpio_wifiAppendRead'
  if (not _gpio_wifiConnected) {
    _smartiot_lastResponse = '0 Not Connected'
    return _smartiot_lastResponse
  }

  local 'lockStart' (millisOp)
  repeatUntil (not _smartiot_requestBusy) {
    if ((millisSince lockStart) >= timeoutMSecs) {
      _smartiot_lastResponse = '0 Request Busy'
      return _smartiot_lastResponse
    }
    waitMillis 10
  }

  _smartiot_requestBusy = true
  _smartiot_lastResponse = ('_gpio_wifiRequest' command responseKey timeoutMSecs)
  _smartiot_requestBusy = false
  if ((size _smartiot_lastResponse) == 0) {
    _smartiot_lastResponse = '0 No Response'
  }
  return _smartiot_lastResponse
}

to '_smartiotStatusCommand' {
  return ('_smartiotATCommand' ('[data:join]' '/iot/iotTopic/getTopicStatus/' _smartiot_token '/' _smartiot_topic))
}

to '_smartiotUpdateSwitchFromResponse' response fireEvent {
  local 'newStatus' _smartiot_switchStatus
  local 'knownStatus' false
  if (('[data:find]' 'switchOn' response) > 0) {
    newStatus = true
    knownStatus = true
  } (('[data:find]' 'switchOff' response) > 0) {
    newStatus = false
    knownStatus = true
  }
  if knownStatus {
    if (and (and fireEvent _smartiot_switchKnown) (newStatus != _smartiot_switchStatus)) {
      if newStatus {
        _smartiot_switchOnEvent = true
      } else {
        _smartiot_switchOffEvent = true
      }
    }
    _smartiot_switchStatus = newStatus
    _smartiot_switchKnown = true
  }
}

to planetX_connectSmartiot userToken topic {
  '_smartiotEnsureDefaults'
  _smartiot_token = userToken
  _smartiot_topic = topic
  _smartiot_connected = false
  repeat 3 {
    local 'response' ('_smartiotATRequest' ('_smartiotStatusCommand') '"code":200' 2000)
    if (('[data:find]' '"code":200' response) > 0) {
      _smartiot_connected = true
      '_smartiotUpdateSwitchFromResponse' response false
      return
    }
    waitMillis 200
  }
}

to planetX_setSmartIotUploadData n1 n2 n3 n4 n5 n6 n7 n8 {
  '_smartiotEnsureDefaults'
  local 'data1' (argOrDefault 1 0)
  local 'data2' (argOrDefault 2 0)
  local 'data3' (argOrDefault 3 0)
  local 'data4' (argOrDefault 4 0)
  local 'data5' (argOrDefault 5 0)
  local 'data6' (argOrDefault 6 0)
  local 'data7' (argOrDefault 7 0)
  local 'data8' (argOrDefault 8 0)
  local 'path' ('[data:join]' '/iot/iotTopicData/addTopicData?userToken=' _smartiot_token '&topicName=' _smartiot_topic '&data1=' data1 '&data2=' data2 '&data3=' data3 '&data4=' data4 '&data5=' data5 '&data6=' data6 '&data7=' data7 '&data8=' data8)
  _smartiot_sendMsg = ('_smartiotATCommand' path)
}

to planetX_uploadSmartIotData {
  '_smartiotEnsureDefaults'
  if (not _smartiot_connected) {return}
  if (_smartiot_sendMsg == 0) {return}
  if ((size _smartiot_sendMsg) == 0) {return}
  if (_smartiot_lastSendTime > 0) {
    local 'elapsed' (millisSince _smartiot_lastSendTime)
    if (elapsed < 1000) {
      waitMillis (1000 - elapsed)
    }
  }
  '_smartiotATRequest' _smartiot_sendMsg '"code":200' 3000
  _smartiot_lastSendTime = (millisOp)
}

to planetX_smartiotState optionalState {
  '_gpio_wifiAppendRead'
  if (not _gpio_wifiConnected) {
    _smartiot_connected = false
  }
  local 'connected' (_smartiot_connected == true)
  local 'legacyState' (argOrDefault 1 'return connection state')
  if (legacyState == 'return connection state') {
    return connected
  }
  return (connected == legacyState)
}

// Product-facing boolean selector; old projects retain the comparison input.
to planetX_smartiotConnected {
  return (planetX_smartiotState)
}

to '_smartiotStartSwitchLoop' {
  '_smartiotEnsureDefaults'
  if (not _smartiot_switchListenFlag) {
    _smartiot_switchListenFlag = true
    sendBroadcast '_smartiotSwitchLoop'
  }
}

to '_smartiotSwitchLoop' {
  forever {
    '_gpio_wifiAppendRead'
    if (and _gpio_wifiConnected _smartiot_connected) {
      local 'response' ('_smartiotATRequest' ('_smartiotStatusCommand') '"code":200' 2000)
      '_smartiotUpdateSwitchFromResponse' response true
    } else {
      if (not _gpio_wifiConnected) {
        _smartiot_connected = false
      }
    }
    waitMillis 1000
  }
}

to planetX_iotSwitchEvent state {
  '_smartiotStartSwitchLoop'
  if (state == 'on') {
    if _smartiot_switchOnEvent {
      _smartiot_switchOnEvent = false
      return true
    }
  } else {
    if _smartiot_switchOffEvent {
      _smartiot_switchOffEvent = false
      return true
    }
  }
  return false
}

to planetX_smartIotSwitchState state {
  '_smartiotEnsureDefaults'
  if (or ((size _smartiot_token) == 0) ((size _smartiot_topic) == 0)) {
    return false
  }

  local 'response' ('_smartiotATRequest' ('_smartiotStatusCommand') '"code":200' 2000)
  if (('[data:find]' '"code":200' response) < 1) {
    return false
  }
  if (not (or (('[data:find]' 'switchOn' response) > 0) (('[data:find]' 'switchOff' response) > 0))) {
    return false
  }

  _smartiot_connected = true
  '_smartiotUpdateSwitchFromResponse' response false
  if (state == 'on') {
    return (_smartiot_switchStatus == true)
  }
  return (_smartiot_switchStatus == false)
}

to '_gpio_wifiWriteAT' command {
  local 'atcmd' ('[data:join]' command ('[data:unicodeString]' 13) ('[data:unicodeString]' 10))
  return ('[elfreaks_dev_sensor:wifiUartWrite]' atcmd)
}

to '_gpio_wifiRequest' command responseKey timeoutMSecs {
  '_gpio_wifiAppendRead'
  _gpio_wifiLastResponse = ''
  if (not ('_gpio_wifiWriteAT' command)) {return ''}
  '_gpio_wifiWaitFor' responseKey timeoutMSecs
  '_gpio_wifiAppendRead'
  return _gpio_wifiLastResponse
}

to '_gpio_wifiAppendRead' {
  local 'newData' ('[data:convertType]' ('[elfreaks_dev_sensor:wifiUartRead]') 'string')
  if ((size newData) > 0) {
    _gpio_wifiLastResponse = ('[data:join]' _gpio_wifiLastResponse newData)
    if (or (('[data:find]' 'WIFI GOT IP' _gpio_wifiLastResponse) > 0) (('[data:find]' 'CONNECTED' _gpio_wifiLastResponse) > 0)) {
      _gpio_wifiConnected = true
    }
    if (or (('[data:find]' 'WIFI DISCONNECT' _gpio_wifiLastResponse) > 0) (('[data:find]' 'DISCONNECT' _gpio_wifiLastResponse) > 0)) {
      _gpio_wifiConnected = false
    }
  }
  return _gpio_wifiLastResponse
}

to '_gpio_wifiWaitFor' key timeoutMSecs {
  local 'start' (millisOp)
  repeatUntil ((millisSince start) > timeoutMSecs) {
    '_gpio_wifiAppendRead'
    if (('[data:find]' key _gpio_wifiLastResponse) > 0) {
      return true
    }
    waitMillis 20
  }
  return false
}

to initWIFI port baudrate {
  _gpio_wifiConnected = false
  _gpio_wifiLastResponse = ''
  _smartiot_connected = false
  _smartiot_requestBusy = false
  '[elfreaks_dev_sensor:wifiUartInit]' port baudrate
  waitMillis 100
  local 'ignore' ('[elfreaks_dev_sensor:wifiUartRead]')
  wifiSendAT 'AT' 500
  wifiSendAT 'AT+CWMODE=1' 500
}

to wifiSendAT command waitMSecs {
  _gpio_wifiLastResponse = ''
  if (not ('_gpio_wifiWriteAT' command)) {return}
  waitMillis waitMSecs
  '_gpio_wifiAppendRead'
}

to connectWifi ssid password {
  _gpio_wifiConnected = false
  _smartiot_connected = false
  repeat 3 {
    local 'cmd' ('[data:join]' 'AT+CWJAP="' ssid '","' password '"')
    wifiSendAT cmd 200
    if ('_gpio_wifiWaitFor' 'WIFI GOT IP' 5000) {
      _gpio_wifiConnected = true
      return
    }
    if ('_gpio_wifiWaitFor' 'OK' 500) {
      _gpio_wifiConnected = true
      return
    }
    wifiSendAT 'AT+RST' 2000
    '_gpio_wifiWaitFor' 'ready' 2000
    wifiSendAT 'AT+CWMODE=1' 500
  }
}

to wifiRead {
  return ('_gpio_wifiAppendRead')
}

to wifiState optionalState {
  '_gpio_wifiAppendRead'
  local 'connected' (_gpio_wifiConnected == true)
  local 'legacyState' (argOrDefault 1 'return connection state')
  if (legacyState == 'return connection state') {
    return connected
  }
  return (connected == legacyState)
}

// Product-facing boolean selector; old projects retain the comparison input.
to wifiConnected {
  return (wifiState)
}

to '_planetX_i2cAcquire' {
  if (_planetX_i2cQueue == 0) {_planetX_i2cQueue = ('[data:makeList]')}
  // Distinct objects identify requests without a wrapping ticket counter.
  local 'request' ('[data:newByteArray]' 1 0)
  '[data:addLast]' request _planetX_i2cQueue
  if (('[data:find]' request _planetX_i2cQueue) < 1) {return false}
  local 'start' (millisOp)
  repeatUntil (and (not _planetX_i2cRequestBusy) ((at 1 _planetX_i2cQueue) == request)) {
    if ((millisSince start) >= 500) {
      local 'index' ('[data:find]' request _planetX_i2cQueue)
      if (index > 0) {'[data:delete]' index _planetX_i2cQueue}
      return false
    }
    waitMillis 1
  }
  _planetX_i2cRequestBusy = true
  return true
}

to '_planetX_i2cRelease' {
  if (not _planetX_i2cRequestBusy) {return}
  '[data:delete]' 1 _planetX_i2cQueue
  _planetX_i2cRequestBusy = false
}

to '_planetX_attentionWaitReady' {
  local 'start' (millisOp)
  repeatUntil (('_planetX_attentionReadByte') == 16) {
    if ((millisSince start) >= 250) {return false}
    waitMillis 1
  }
  return true
}

to '_planetX_attentionRequest' command {
  if (not ('_planetX_i2cAcquire')) {return -1}
  // Match the former i2cPort transport clock, without an extra probe write.
  '[sensors:i2cSetClockSpeed]' 200000
  local 'value' -1
  if ('_planetX_attentionWaitReady') {
    '[sensors:i2cWrite]' 8 command
    value = ('_planetX_attentionReadByte')
  }
  '_planetX_i2cRelease'
  return value
}
