to '_float power' n {
  local 'x' ('[misc:float32FromString]' '1.0001')
  local 'y' ('[misc:float32FromString]' '1.5')
  local 'sink' x
  local 'start' (microsOp)
  repeat n {sink = ('[misc:float32Power]' x y); sink = ('[misc:float32Power]' x y); sink = ('[misc:float32Power]' x y); sink = ('[misc:float32Power]' x y)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float sin' n {
  local 'x' ('[misc:float32FromString]' '0.5')
  local 'sink' x
  local 'start' (microsOp)
  repeat n {sink = ('[misc:float32Sin]' x); sink = ('[misc:float32Sin]' x); sink = ('[misc:float32Sin]' x); sink = ('[misc:float32Sin]' x)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float cos' n {
  local 'x' ('[misc:float32FromString]' '0.5')
  local 'sink' x
  local 'start' (microsOp)
  repeat n {sink = ('[misc:float32Cos]' x); sink = ('[misc:float32Cos]' x); sink = ('[misc:float32Cos]' x); sink = ('[misc:float32Cos]' x)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float tan' n {
  local 'x' ('[misc:float32FromString]' '0.5')
  local 'sink' x
  local 'start' (microsOp)
  repeat n {sink = ('[misc:float32Tan]' x); sink = ('[misc:float32Tan]' x); sink = ('[misc:float32Tan]' x); sink = ('[misc:float32Tan]' x)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float atan' n {
  local 'x' ('[misc:float32FromString]' '0.5')
  local 'sink' x
  local 'start' (microsOp)
  repeat n {sink = ('[misc:float32Atan]' x); sink = ('[misc:float32Atan]' x); sink = ('[misc:float32Atan]' x); sink = ('[misc:float32Atan]' x)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float atan2' n {
  local 'x' ('[misc:float32FromString]' '1.0')
  local 'y' ('[misc:float32FromString]' '0.5')
  local 'sink' x
  local 'start' (microsOp)
  repeat n {sink = ('[misc:float32Atan2]' x y); sink = ('[misc:float32Atan2]' x y); sink = ('[misc:float32Atan2]' x y); sink = ('[misc:float32Atan2]' x y)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float round' n {
  local 'x' ('[misc:float32FromString]' '1.75')
  local 'sink' 0
  local 'start' (microsOp)
  repeat n {sink = ('[misc:roundFloat32ToInt]' x); sink = ('[misc:roundFloat32ToInt]' x); sink = ('[misc:roundFloat32ToInt]' x); sink = ('[misc:roundFloat32ToInt]' x)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float trunc' n {
  local 'x' ('[misc:float32FromString]' '1.75')
  local 'sink' 0
  local 'start' (microsOp)
  repeat n {sink = ('[misc:truncateFloat32ToInt]' x); sink = ('[misc:truncateFloat32ToInt]' x); sink = ('[misc:truncateFloat32ToInt]' x); sink = ('[misc:truncateFloat32ToInt]' x)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float rescale' n {
  local 'x' ('[misc:float32FromString]' '3.0')
  local 'lo' ('[misc:float32FromString]' '0.0')
  local 'hi' ('[misc:float32FromString]' '10.0')
  local 'outLo' ('[misc:float32FromString]' '0.0')
  local 'outHi' ('[misc:float32FromString]' '100.0')
  local 'sink' x
  local 'start' (microsOp)
  repeat n {sink = ('[misc:float32Rescale]' x lo hi outLo outHi); sink = ('[misc:float32Rescale]' x lo hi outLo outHi); sink = ('[misc:float32Rescale]' x lo hi outLo outHi); sink = ('[misc:float32Rescale]' x lo hi outLo outHi)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float to text' n {
  local 'x' ('[misc:float32FromString]' '1.234567')
  local 'sink' ''
  local 'start' (microsOp)
  repeat n {sink = ('[data:float32ToString]' x); sink = ('[data:float32ToString]' x); sink = ('[data:float32ToString]' x); sink = ('[data:float32ToString]' x)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

module '32-bit Floats' Operators
author MicroBlocks
version 1 3
description 'Requires firmware built with -DUSE_32BIT_FLOAT. Adds IEEE-754 32-bit floating-point values while preserving the original MicroBlocks integer range and operations. Trigonometric inputs and results use radians. The collapsed printf block uses fixed notation; exposing exponent digits selects scientific notation. Formatting width is a minimum; use a negative width to left-align. Decimal digits and exponent digits are clamped to 0-30.'
tags math number float '32-bit'

	spec 'r' '[misc:float32FromString]' '32-bit float from text _' 'str' '3.1415927'
	spec 'r' '[misc:isFloat32]' '_ is a 32-bit float?' 'auto' 0
	-
	spec 'r' '[misc:float32Sqrt]' '32-bit sqrt _' 'num' 2
	spec 'r' '[misc:float32Power]' '32-bit _ to power _' 'num num' 2 8
	spec 'r' '[misc:float32Sin]' '32-bit sin radians _' 'num' 0
	spec 'r' '[misc:float32Cos]' '32-bit cos radians _' 'num' 0
	spec 'r' '[misc:float32Tan]' '32-bit tan radians _' 'num' 0
	spec 'r' '[misc:float32Atan]' '32-bit arctan _ (radians)' 'num' 1
	spec 'r' '[misc:float32Atan2]' '32-bit arctan x _ y _ (radians)' 'num num' 1 1
	-
	spec 'r' '[misc:roundFloat32ToInt]' 'round 32-bit float _ to integer' 'num' 1
	spec 'r' '[misc:truncateFloat32ToInt]' 'truncate 32-bit float _ to integer' 'num' 1
	spec 'r' '[misc:float32Rescale]' '32-bit rescale _ from ( _ , _ ) to ( _ , _ )' 'num num num num num' 3 0 10 0 100
	-
	spec 'r' '[data:float32ToString]' '32-bit float _ as text' 'auto' 0
	spec 'r' '[data:float32Printf]' '32-bit printf _ width _ digits _ : exponent digits _' 'num num num num' 3 0 6 2
