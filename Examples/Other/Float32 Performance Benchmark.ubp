module main
author OpenAI
version 1 0
description 'Measures default integer and Float32 operators, comparisons, and the 32-bit Floats library functions. Results are median-of-three microseconds per operation. Gross includes normal loop/value overhead; net subtracts an appropriate baseline.'
variables checksum resultText 'arithmetic results' 'comparison results' 'library results'

script 40 40 {
whenStarted
sayIt 'Running Float32 benchmark...'
'_clear saved results'
'_run benchmarks'
sayIt 'Float32 benchmark complete. Click a result stack.'
}

script 520 40 {
comment 'Click this stack after the benchmark finishes.'
sayIt (v 'arithmetic results')
}

script 520 130 {
comment 'Click this stack after the benchmark finishes.'
sayIt (v 'comparison results')
}

script 520 220 {
comment 'Click this stack after the benchmark finishes.'
sayIt (v 'library results')
}

to '_run benchmarks' {
  sayIt 'Measuring arithmetic...'
  '_run arithmetic'
  sayIt 'Measuring comparisons...'
  '_run comparisons'
  sayIt 'Measuring library math...'
  '_run library functions'
}

to '_clear saved results' {
  resultText = ''
  'arithmetic results' = 'Not run yet'
  'comparison results' = 'Not run yet'
  'library results' = 'Not run yet'
  '[misc:clearGraph]'
  graphIt 'test gross_us/op net_us/op'
}

to '_run arithmetic' {
  resultText = 'Arithmetic gross/net us/op: '
  local 'fastN' 10000
  local 'fastOps' (fastN * 8)
  local 'body4Ops' (fastN * 4)
  local 'arithBase' ('_median3' ('_arith baseline' fastN) ('_arith baseline' fastN) ('_arith baseline' fastN))
  local 'body4Base' ('_median3' ('_body4 baseline' fastN) ('_body4 baseline' fastN) ('_body4 baseline' fastN))
  '_record' 'I+' ('_median3' ('_int add' fastN) ('_int add' fastN) ('_int add' fastN)) arithBase fastOps
  '_record' 'I-' ('_median3' ('_int subtract' fastN) ('_int subtract' fastN) ('_int subtract' fastN)) arithBase fastOps
  '_record' 'I*' ('_median3' ('_int multiply' fastN) ('_int multiply' fastN) ('_int multiply' fastN)) arithBase fastOps
  '_record' 'I/' ('_median3' ('_int divide' fastN) ('_int divide' fastN) ('_int divide' fastN)) arithBase fastOps
  '_record' 'F32+' ('_median3' ('_float add' fastN) ('_float add' fastN) ('_float add' fastN)) arithBase fastOps
  '_record' 'F32-' ('_median3' ('_float subtract' fastN) ('_float subtract' fastN) ('_float subtract' fastN)) arithBase fastOps
  '_record' 'F32*' ('_median3' ('_float multiply' fastN) ('_float multiply' fastN) ('_float multiply' fastN)) arithBase fastOps
  '_record' 'F32/' ('_median3' ('_float divide' fastN) ('_float divide' fastN) ('_float divide' fastN)) arithBase fastOps
  '_record' 'Iabs' ('_median3' ('_int abs' fastN) ('_int abs' fastN) ('_int abs' fastN)) body4Base body4Ops
  '_record' 'F32abs' ('_median3' ('_float abs' fastN) ('_float abs' fastN) ('_float abs' fastN)) body4Base body4Ops
  'arithmetic results' = (v 'resultText')
}

to '_run comparisons' {
  resultText = 'Comparisons gross/net us/op: '
  local 'fastN' 10000
  local 'body4Ops' (fastN * 4)
  local 'body4Base' ('_median3' ('_body4 baseline' fastN) ('_body4 baseline' fastN) ('_body4 baseline' fastN))
  '_record' 'I<' ('_median3' ('_int less' fastN) ('_int less' fastN) ('_int less' fastN)) body4Base body4Ops
  '_record' 'F32<' ('_median3' ('_float less' fastN) ('_float less' fastN) ('_float less' fastN)) body4Base body4Ops
  '_record' 'I=' ('_median3' ('_int equal' fastN) ('_int equal' fastN) ('_int equal' fastN)) body4Base body4Ops
  '_record' 'F32=' ('_median3' ('_float equal' fastN) ('_float equal' fastN) ('_float equal' fastN)) body4Base body4Ops
  '_record' 'I>' ('_median3' ('_int greater' fastN) ('_int greater' fastN) ('_int greater' fastN)) body4Base body4Ops
  '_record' 'F32>' ('_median3' ('_float greater' fastN) ('_float greater' fastN) ('_float greater' fastN)) body4Base body4Ops
  'comparison results' = (v 'resultText')
}

to '_run library functions' {
  resultText = 'Library gross/net us/op: '
  local 'specialN' 1000
  local 'slowOps' (specialN * 4)
  local 'cloneBase' ('_median3' ('_float clone' specialN) ('_float clone' specialN) ('_float clone' specialN))
  local 'checkBase' ('_median3' ('_float check' specialN) ('_float check' specialN) ('_float check' specialN))
  '_run library unary' specialN slowOps cloneBase
  '_run library other' specialN slowOps cloneBase checkBase
  'library results' = (v 'resultText')
}

to '_run library unary' specialN slowOps cloneBase {
  '_record' 'parse' ('_median3' ('_float parse' specialN) ('_float parse' specialN) ('_float parse' specialN)) cloneBase slowOps
  '_record' 'sqrt' ('_median3' ('_float sqrt' specialN) ('_float sqrt' specialN) ('_float sqrt' specialN)) cloneBase slowOps
  '_record' 'power' ('_median3' ('_float power' specialN) ('_float power' specialN) ('_float power' specialN)) cloneBase slowOps
  '_record' 'sin' ('_median3' ('_float sin' specialN) ('_float sin' specialN) ('_float sin' specialN)) cloneBase slowOps
  '_record' 'cos' ('_median3' ('_float cos' specialN) ('_float cos' specialN) ('_float cos' specialN)) cloneBase slowOps
  '_record' 'tan' ('_median3' ('_float tan' specialN) ('_float tan' specialN) ('_float tan' specialN)) cloneBase slowOps
  '_record' 'atan' ('_median3' ('_float atan' specialN) ('_float atan' specialN) ('_float atan' specialN)) cloneBase slowOps
}

to '_run library other' specialN slowOps cloneBase checkBase {
  '_record' 'atan2' ('_median3' ('_float atan2' specialN) ('_float atan2' specialN) ('_float atan2' specialN)) cloneBase slowOps
  '_record' 'round' ('_median3' ('_float round' specialN) ('_float round' specialN) ('_float round' specialN)) checkBase slowOps
  '_record' 'trunc' ('_median3' ('_float trunc' specialN) ('_float trunc' specialN) ('_float trunc' specialN)) checkBase slowOps
  '_record' 'rescale' ('_median3' ('_float rescale' specialN) ('_float rescale' specialN) ('_float rescale' specialN)) cloneBase slowOps
  '_record' 'toText' ('_median3' ('_float to text' specialN) ('_float to text' specialN) ('_float to text' specialN)) cloneBase slowOps
}

to '_record' label elapsed baseline operationCount {
  local 'gross' (('[misc:float32FromString]' elapsed) / operationCount)
  local 'net' (('[misc:float32FromString]' (maximum 0 (elapsed - baseline))) / operationCount)
  resultText = ('[data:join]' (v 'resultText') label ' g=' ('[data:float32ToString]' gross) ' n=' ('[data:float32ToString]' net) '; ')
  graphIt label gross net
}

to '_median3' a b c {
  return (((sum a b c) - (minimum a b c)) - (maximum a b c))
}

to '_arith baseline' n {
  local 'x' 12345
  local 'start' (microsOp)
  repeat n {x = x}
  local 'elapsed' (microsSince start)
  checksum = x
  return elapsed
}

to '_body4 baseline' n {
  local 'x' 12345
  local 'sink' 0
  local 'start' (microsOp)
  repeat n {
    sink = x
    sink = x
    sink = x
    sink = x
  }
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_int add' n {
  local 'x' 12345
  local 'y' 3
  local 'start' (microsOp)
  repeat n {x = ((((((((x + y) + y) + y) + y) + y) + y) + y) + y)}
  local 'elapsed' (microsSince start)
  checksum = x
  return elapsed
}

to '_int subtract' n {
  local 'x' 500000
  local 'y' 3
  local 'start' (microsOp)
  repeat n {x = ((((((((x - y) - y) - y) - y) - y) - y) - y) - y)}
  local 'elapsed' (microsSince start)
  checksum = x
  return elapsed
}

to '_int multiply' n {
  local 'x' 0
  local 'y' 7654321
  local 'start' (microsOp)
  repeat n {x = ((((((((x * y) * y) * y) * y) * y) * y) * y) * y)}
  local 'elapsed' (microsSince start)
  checksum = x
  return elapsed
}

to '_int divide' n {
  local 'x' 7654321
  local 'y' 1
  local 'start' (microsOp)
  repeat n {x = ((((((((x / y) / y) / y) / y) / y) / y) / y) / y)}
  local 'elapsed' (microsSince start)
  checksum = x
  return elapsed
}

to '_float add' n {
  local 'x' ('[misc:float32FromString]' '1.25')
  local 'y' ('[misc:float32FromString]' '0.125')
  local 'start' (microsOp)
  repeat n {x = ((((((((x + y) + y) + y) + y) + y) + y) + y) + y)}
  local 'elapsed' (microsSince start)
  checksum = x
  return elapsed
}

to '_float subtract' n {
  local 'x' ('[misc:float32FromString]' '10001.25')
  local 'y' ('[misc:float32FromString]' '0.125')
  local 'start' (microsOp)
  repeat n {x = ((((((((x - y) - y) - y) - y) - y) - y) - y) - y)}
  local 'elapsed' (microsSince start)
  checksum = x
  return elapsed
}

to '_float multiply' n {
  local 'x' ('[misc:float32FromString]' '1.25')
  local 'y' ('[misc:float32FromString]' '1.000001')
  local 'start' (microsOp)
  repeat n {x = ((((((((x * y) * y) * y) * y) * y) * y) * y) * y)}
  local 'elapsed' (microsSince start)
  checksum = x
  return elapsed
}

to '_float divide' n {
  local 'x' ('[misc:float32FromString]' '1.25')
  local 'y' ('[misc:float32FromString]' '1.000001')
  local 'start' (microsOp)
  repeat n {x = ((((((((x / y) / y) / y) / y) / y) / y) / y) / y)}
  local 'elapsed' (microsSince start)
  checksum = x
  return elapsed
}

to '_int abs' n {
  local 'x' -123456
  local 'start' (microsOp)
  repeat n {x = (absoluteValue (absoluteValue (absoluteValue (absoluteValue x))))}
  local 'elapsed' (microsSince start)
  checksum = x
  return elapsed
}

to '_float abs' n {
  local 'x' ('[misc:float32FromString]' '-1.25')
  local 'start' (microsOp)
  repeat n {x = (absoluteValue (absoluteValue (absoluteValue (absoluteValue x))))}
  local 'elapsed' (microsSince start)
  checksum = x
  return elapsed
}

to '_int less' n {
  local 'a' 123456
  local 'b' 654321
  local 'sink' false
  local 'start' (microsOp)
  repeat n {sink = (a < b); sink = (a < b); sink = (a < b); sink = (a < b)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float less' n {
  local 'a' ('[misc:float32FromString]' '1.25')
  local 'b' ('[misc:float32FromString]' '2.5')
  local 'sink' false
  local 'start' (microsOp)
  repeat n {sink = (a < b); sink = (a < b); sink = (a < b); sink = (a < b)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_int equal' n {
  local 'a' 123456
  local 'b' 123456
  local 'sink' false
  local 'start' (microsOp)
  repeat n {sink = (a == b); sink = (a == b); sink = (a == b); sink = (a == b)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float equal' n {
  local 'a' ('[misc:float32FromString]' '1.25')
  local 'b' ('[misc:float32FromString]' '1.25')
  local 'sink' false
  local 'start' (microsOp)
  repeat n {sink = (a == b); sink = (a == b); sink = (a == b); sink = (a == b)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_int greater' n {
  local 'a' 654321
  local 'b' 123456
  local 'sink' false
  local 'start' (microsOp)
  repeat n {sink = (a > b); sink = (a > b); sink = (a > b); sink = (a > b)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float greater' n {
  local 'a' ('[misc:float32FromString]' '2.5')
  local 'b' ('[misc:float32FromString]' '1.25')
  local 'sink' false
  local 'start' (microsOp)
  repeat n {sink = (a > b); sink = (a > b); sink = (a > b); sink = (a > b)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float clone' n {
  local 'x' ('[misc:float32FromString]' '1.25')
  local 'sink' x
  local 'start' (microsOp)
  repeat n {sink = ('[misc:float32FromString]' x); sink = ('[misc:float32FromString]' x); sink = ('[misc:float32FromString]' x); sink = ('[misc:float32FromString]' x)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float check' n {
  local 'x' ('[misc:float32FromString]' '1.25')
  local 'sink' false
  local 'start' (microsOp)
  repeat n {sink = ('[misc:isFloat32]' x); sink = ('[misc:isFloat32]' x); sink = ('[misc:isFloat32]' x); sink = ('[misc:isFloat32]' x)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float parse' n {
  local 'text' '1.234567'
  local 'sink' 0
  local 'start' (microsOp)
  repeat n {sink = ('[misc:float32FromString]' text); sink = ('[misc:float32FromString]' text); sink = ('[misc:float32FromString]' text); sink = ('[misc:float32FromString]' text)}
  local 'elapsed' (microsSince start)
  checksum = sink
  return elapsed
}

to '_float sqrt' n {
  local 'x' ('[misc:float32FromString]' '2.0')
  local 'sink' x
  local 'start' (microsOp)
  repeat n {sink = ('[misc:float32Sqrt]' x); sink = ('[misc:float32Sqrt]' x); sink = ('[misc:float32Sqrt]' x); sink = ('[misc:float32Sqrt]' x)}
  local 'elapsed' (microsSince start)
  checksum = sink
